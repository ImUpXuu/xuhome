---
import CalendarWidget from './CalendarWidget.svelte';
import SidebarTags from './SidebarTags.astro';
import AuthorCard from './AuthorCard.astro';

interface CalendarPost {
  slug: string;
  title: string;
  date: string;
  description: string;
}

export interface Props {
  posts?: CalendarPost[];
  /** 只传日期的最小载荷（首页用，避免整份文章列表进 props） */
  calendarDates?: string[];
  /** 客户端补全日历标题/描述用的共享索引地址 */
  calendarDataUrl?: string;
  tags: { name: string; count: number }[];
  activeTag?: string | null;
  showCalendar?: boolean;
  showTags?: boolean;
  showAuthor?: boolean;
}

const {
  posts = [],
  calendarDates = [],
  calendarDataUrl = '',
  tags,
  activeTag = null,
  showCalendar = true,
  showTags = true,
  showAuthor = true,
} = Astro.props;
---

{
  showAuthor && <AuthorCard />
}
{
  showCalendar && <CalendarWidget posts={posts} dates={calendarDates} dataUrl={calendarDataUrl} client:idle />
}
{
  showTags && <SidebarTags tags={tags} activeTag={activeTag} />
}
