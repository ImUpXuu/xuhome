---
import { siteConfig, footerConfig } from '../config/site';
import { infoConfig } from '../config/info';
import { seoConfig } from '../config/seo';
import { ClientRouter } from 'astro:transitions';
import NavBar from '../components/NavBar.astro';
import PrefetchLinks from '../components/PrefetchLinks.svelte';
// 暂时禁用：import WelcomeToast from '../components/WelcomeToast.astro';
import { PageBanner } from '../components/PageBanner';
import MusicPlayer from '../components/MusicPlayer.svelte';
import { execSync } from 'child_process';
import { getCollection } from 'astro:content';
import '../index.css';

// 页脚字数统计：文章 + 说说的正文字符数合计（去掉图片语法与空白）
const footerPosts = await getCollection('posts');
const footerTalks = await getCollection('talks');
const stripMarkdown = (s: string) => s
  .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
  .replace(/<img[^>]*>/gi, '')
  .replace(/\s+/g, '');
const footerChars = footerPosts.reduce((sum, p) => sum + stripMarkdown(p.body || '').length, 0)
  + footerTalks.reduce((sum, t) => sum + stripMarkdown(t.body || '').length, 0);
const wordCountK = (footerChars / 1000).toFixed(1);

const DEFAULT_BG_URL = 'https://img.upxuu.lcrworld.xyz/images/2026/7/1.webp';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  categoryName?: string | null;
  tagName?: string | null;
  post?: { title: string; date: string; dateISO?: string; keywords?: string[] } | null;
  keywords?: string[] | null;
  isTalk?: boolean;
  postsCount?: number;
  isAboutPage?: boolean;
  isArticle?: boolean;
  hideFooter?: boolean;
  hideBanner?: boolean;
}

const {
  title,
  description,
  image = seoConfig.defaultImage,
  categoryName = null,
  tagName = null,
  post = null,
  keywords = null,
  isTalk = false,
  postsCount = 0,
  isAboutPage = false,
  isArticle = false,
  hideFooter = false,
  hideBanner = false,
} = Astro.props;

const pageTitle = title
  ? (title.endsWith(seoConfig.titleTemplate)
      ? title
      : `${title}${seoConfig.titleTemplate}`)
  : `${siteConfig.title} - ${siteConfig.subtitle.split(' / ')[0]}`;
const pageDescription = (description || seoConfig.defaultDescription).length < 10 
  ? seoConfig.defaultDescription 
  : (description || seoConfig.defaultDescription);
const pageKeywords = keywords?.length
  ? keywords
  : post?.keywords?.length
    ? post.keywords
    : seoConfig.keywords;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.url).href;
const resolvedImage = image || seoConfig.defaultImage;
const isMusicPage = Astro.url.pathname === '/music' || Astro.url.pathname.startsWith('/music/');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords.join(", ")} />
    <meta name="author" content={siteConfig.author} />
    <meta name="robots" content={seoConfig.robots} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="msvalidate.01" content="8814B55DAA53801F47B998FE06421544" />
    {/* Favicon - use avatar image */}
    <link rel="icon" href={siteConfig.avatar} />
    <link rel="apple-touch-icon" href={siteConfig.avatar} />
    {/* WebMCP 工具注册 */}
    <script is:inline src="/webmcp-register.js"></script>

    {/* Open Graph Tags */}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={post ? "article" : "website"} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="zh-CN" />
    <meta property="og:url" content={canonicalURL} />
    {post && <meta property="article:published_time" content={post.dateISO || post.date} />}
    
    {/* Twitter Card Tags */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={seoConfig.twitter.site} />
    <meta name="twitter:creator" content={seoConfig.twitter.creator} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={resolvedImage} />

    {/* JSON-LD Structured Data */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${siteConfig.url}/#website`,
          "url": siteConfig.url,
          "name": siteConfig.title,
          "description": siteConfig.description,
          "inLanguage": "zh-CN"
        },
        {
          "@type": "Person",
          "@id": `${siteConfig.url}/#person`,
          "name": siteConfig.author,
          "url": siteConfig.url,
          "image": siteConfig.avatar,
          "sameAs": [
            siteConfig.socials.github
          ]
        },
        ...(post ? [{
          "@type": "Article",
          "@id": `${canonicalURL}#article`,
          "headline": post.title,
          "description": pageDescription,
          "image": resolvedImage,
          "datePublished": post.dateISO || post.date,
          "author": {
            "@type": "Person",
            "name": siteConfig.author,
            "url": siteConfig.url,
            "image": siteConfig.avatar
          },
          "publisher": {
            "@type": "Person",
            "name": siteConfig.author,
            "image": siteConfig.avatar
          },
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": canonicalURL
          }
        }] : [])
      ]
    })} />

    {/* Dynamic Prefetch & Preconnect */}
    {seoConfig.dnsPrefetch.map(domain => (
      <link rel="dns-prefetch" href={domain} />
    ))}
    {seoConfig.preconnect.map(conn => (
      <link rel="preconnect" href={conn.url} crossorigin={conn.crossOrigin === "anonymous" ? "anonymous" : undefined} />
    ))}
    {/* 自托管字体（CDN: img.upxuu.lcrworld.xyz），不再请求 Google Fonts */}
    <link rel="preconnect" href="https://img.upxuu.lcrworld.xyz" crossorigin />
    <link rel="stylesheet" href="https://img.upxuu.lcrworld.xyz/font/fonts.css" />
    {!isArticle && <link rel="preload" as="image" href={DEFAULT_BG_URL} fetchpriority="high" />}

    {siteConfig.analytics.umami.map(u => (
      <script defer src={u.src} data-website-id={u.id}></script>
    ))}
    <script type="text/javascript">
      /* Clarity：页面 load 后再加载，不阻塞首屏 */
      window.addEventListener('load', function() {
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "uziyyjxiky");
      });
    </script>
  <style is:global>
    @keyframes content-in {
      0% { opacity: 0; transform: translateY(20px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes content-out {
      0% { opacity: 1; transform: translateY(0); }
      100% { opacity: 0; transform: translateY(15px); }
    }
    /* Card Specific Entrance - Used for staggered listing */
    @keyframes card-entrance {
      0% { 
        opacity: 0; 
        transform: translateY(30px) scale(0.96);
      }
      70% {
        opacity: 1;
        transform: translateY(-4px) scale(1.02);
      }
      100% { 
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    .animate-card-entrance {
      animation: card-entrance 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    /* 减弱动态效果：禁用 blur，降低动画幅度 */
    @media (prefers-reduced-motion: reduce) {
      @keyframes content-in {
        0% { opacity: 0; }
        100% { opacity: 1; }
      }
      @keyframes content-out {
        100% { opacity: 0; }
      }
      @keyframes card-entrance {
        0% { opacity: 0; }
        100% { opacity: 1; }
      }
    }

    /* ===== 缓存调试面板：右下角横条 ===== */
    .cache-panel {
      position: fixed;
      bottom: 8px;
      right: 8px;
      z-index: 99999;
      font: 11px/1.4 ui-monospace, monospace;
      color: #94a3b8;
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid #334155;
      border-radius: 6px;
      padding: 6px 10px;
      pointer-events: none;
      white-space: nowrap;
      backdrop-filter: blur(4px);
    }
    .cache-panel-header { display: none; }
    .cache-panel-stats { display: inline; }
    .cache-stat { display: inline; margin: 0 2px; }
    .cache-stat-cached { color: #34d399; }
    .cache-stat-queued { color: #fbbf24; }
    .cache-stat-loading { color: #60a5fa; }
    .cache-stat-hit { color: #34d399; font-weight: 700; }
    .cache-stat-miss { color: #f87171; font-weight: 700; }

    /* ===== HIT/MISS 弹出提示 ===== */
    .cache-toast {
      position: fixed;
      z-index: 999999;
      font: 700 11px/1 ui-monospace, monospace;
      padding: 4px 8px;
      border-radius: 4px;
      pointer-events: none;
      transition: opacity 0.18s ease, transform 0.18s ease;
      transform: translateY(0);
      letter-spacing: 0.02em;
    }
    .cache-toast-hit {
      background: rgba(52, 211, 153, 0.95);
      color: #064e3b;
      box-shadow: 0 2px 8px rgba(52, 211, 153, 0.3);
    }
    .cache-toast-miss {
      background: rgba(248, 113, 113, 0.95);
      color: #7f1d1d;
      box-shadow: 0 2px 8px rgba(248, 113, 113, 0.3);
    }

  </style>
  {/* Dark mode init: read persisted theme before first paint */}
  <script is:inline>
    (function() {
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {
        // localStorage may be unavailable in some contexts
      }
    })();
  </script>
  <ClientRouter />
</head>
  <body data-bg-url={!isArticle ? DEFAULT_BG_URL : ''} data-is-article={isArticle ? "true" : "false"} class="dark:bg-slate-900 text-slate-900 dark:text-slate-100 selection:bg-[#fde68a] selection:text-[#0284c7]">
    {/* Persistent full-page bg layer (survives View Transitions) */}
    <div
      id="site-bg"
      transition:persist="site-bg"
      class="fixed inset-0 -z-10 pointer-events-none"
      aria-hidden="true"
    ></div>
    <div id="site-bg-loader" transition:persist="site-bg-loader" aria-hidden="true">
      <div class="bg-bricks">
        <span class="bg-brick"></span>
        <span class="bg-brick"></span>
        <span class="bg-brick"></span>
      </div>
      <span class="bg-loader-text">loading</span>
      <div class="bg-mini-bar"><i id="site-bg-loader-bar"></i></div>
      <span class="bg-loader-meta" id="site-bg-loader-meta" hidden>0 / 0 · 0%</span>
    </div>
    <!-- Tiny top bar + count only while real resources are loading -->
    <div id="resource-progress" transition:persist="resource-progress" aria-hidden="true">
      <i></i>
      <span id="resource-progress-meta" hidden>0 / 0 · 0%</span>
    </div>
    <!-- Skip to content for keyboard users -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200] focus:bg-[#0284c7] focus:text-white focus:px-4 focus:py-2 focus:rounded-sm focus:font-black focus:text-sm focus:shadow-[4px_4px_0px_0px_#fde68a] focus:no-underline focus:outline-none">
      跳转到主要内容
    </a>
    {/* Global reading progress bar */}
    <div class="fixed top-0 left-0 w-full h-[5px] bg-transparent z-[110] pointer-events-none">
      <div 
        id="scroll-bar-indicator"
        class="h-full bg-gradient-to-r from-[#0284c7] via-[#0ea5e9] to-[#f59e0b] origin-left w-0 transition-all duration-75"
      ></div>
    </div>
    {/* 缓存系统：面板 + HIT/MISS 弹出提示（persist 保持跨页面） */}
    <div id="cache-panel" class="cache-panel" transition:persist="cache-panel" style="display:none">
      <div class="cache-panel-header">⚡ Cache</div>
      <div id="cache-panel-stats" class="cache-panel-stats">—</div>
    </div>
    <div id="cache-toast" class="cache-toast" transition:persist="cache-toast" style="display:none"></div>
    <script is:inline>
    (function () {
      // 不开 debug 就什么都不运行
      if (sessionStorage.getItem('cacheDebug') !== '1') {
        // 只在 /cachelog 路径开启
        if (window.location.pathname === '/cachelog' || window.location.pathname === '/cachelog/') {
          try { sessionStorage.setItem('cacheDebug', '1'); } catch {}
        } else {
          return; // 不是 debug 模式，直接退出
        }
      }

      var panel = document.getElementById('cache-panel');
      var statsEl = document.getElementById('cache-panel-stats');
      var toast = document.getElementById('cache-toast');
      if (!panel || !statsEl || !toast) return;

      // 更新面板内容
      function updatePanel() {
        panel.style.display = '';
        var s = window.__cacheStats || {};
        var parts = [];
        parts.push('<span class="cache-stat cache-stat-cached">' + (s.cached || 0) + ' cached</span>');
        parts.push('<span class="cache-stat cache-stat-queued">' + (s.queued || 0) + ' queued</span>');
        parts.push('<span class="cache-stat cache-stat-loading">' + (s.loading || 0) + ' loading</span>');
        var last = sessionStorage.getItem('[cache]lastClick');
        if (last) {
          var isHit = last.indexOf('HIT ') === 0;
          var slug = last.replace(/^(HIT|MISS) /, '');
          parts.push('<span class="cache-stat ' + (isHit ? 'cache-stat-hit' : 'cache-stat-miss') + '">' + (isHit ? '✓ HIT ' : '✗ MISS ') + slug + '</span>');
        }
        statsEl.innerHTML = parts.join('');
      }

      updatePanel();
      setInterval(updatePanel, 500);
      document.addEventListener('astro:page-load', updatePanel);
      document.addEventListener('astro:after-swap', updatePanel);

      // HIT/MISS 弹出提示
      var toastTimer = null;
      function showToast(hit, x, y) {
        toast.textContent = hit ? '✓ HIT' : '✗ MISS';
        toast.className = 'cache-toast cache-toast-' + (hit ? 'hit' : 'miss');
        toast.style.left = x + 'px';
        toast.style.top = (y - 30) + 'px';
        toast.style.display = '';
        toast.style.opacity = '1';
        toast.style.transform = 'translateY(0)';
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(-8px)';
          setTimeout(function () { toast.style.display = 'none'; }, 200);
        }, 1200);
      }

      // 只在 debug 模式下监听点击（不阻塞导航）
      document.addEventListener('click', function (e) {
        var link = e.target.closest('a[href^="/posts/"]');
        if (!link) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        var url = link.href;
        if (/\/posts\/?$/.test(url)) return;

        var slug = url.split('/').filter(Boolean).pop() || '';
        var absUrl = url.startsWith('http') ? url : location.origin + url;

        // 异步查缓存，不阻塞导航
        caches.open('xuhome-article-cache-v1').then(function (cache) {
          return cache.match(new Request(absUrl));
        }).then(function (res) {
          if (!res) return false;
          return res.json().then(function (data) {
            return data && data.html && Date.now() - data.ts < 30 * 60 * 1000;
          });
        }).then(function (hit) {
          try { sessionStorage.setItem('[cache]lastClick', (hit ? 'HIT ' : 'MISS ') + slug); } catch {}
          showToast(hit, e.clientX, e.clientY);
          updatePanel();
        }).catch(function () {});
      }, true);
    })();
    </script>
    {/* 暂时禁用：<WelcomeToast /> */}
    <div class={isMusicPage ? 'flex flex-col h-[100dvh] overflow-hidden' : 'flex flex-col min-h-screen'}>
      <NavBar />
      
      {!isAboutPage ? (
        <div 
          class={`dark:bg-slate-900 px-2 font-sans transition-all duration-300 ${
            isMusicPage
              ? 'h-full overflow-hidden'
              : 'min-h-screen py-2 sm:py-6 sm:px-6 md:py-8 md:px-8'
          } ${isArticle ? "article-paper-shell" : ""}`}
          style={!isArticle ? { backgroundImage: "radial-gradient(#0284c70d 2px, transparent 2px)", backgroundSize: "24px 24px" } : undefined}
        >
          <div class="max-w-[1440px] w-full mx-auto flex flex-col gap-3 sm:gap-6">
            {!hideBanner && (
            <PageBanner 
              client:load
              pathname={Astro.url.pathname}
              categoryName={categoryName}
              tagName={tagName}
              post={post}
              postsCount={postsCount}
            />
            )}

            <main
              id="main-content"
              class="flex-1"
              transition:animate={{
                forwards: {
                  old: [{ name: 'content-out', duration: '0.2s', easing: 'ease-in' }],
                  new: [{ name: 'content-in', duration: '0.35s', easing: 'ease-out' }]
                },
                backwards: {
                  old: [{ name: 'content-out', duration: '0.2s', easing: 'ease-in' }],
                  new: [{ name: 'content-in', duration: '0.35s', easing: 'ease-out' }]
                }
              }}
            >
              <slot />
            </main>
          </div>
        </div>
      ) : (
        <main class="flex-1">
          <slot />
        </main>
      )}
      
      {!hideFooter && (
      <footer class="w-full select-none">
        <div class="max-w-5xl mx-auto px-4 py-6 text-center text-xs font-mono text-black dark:text-slate-300 leading-relaxed space-y-3">
          {/* 导航链接：积木粗野主义按钮组 */}
          <div class="flex flex-wrap justify-center gap-2">
            {infoConfig.footer.links.map((link) => (
              <a href={link.path} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}
                 class="px-3 py-1 border-2 border-[#0284c7] rounded-sm font-black text-xs text-[#0284c7] bg-[#fde68a] shadow-[2px_2px_0px_0px_#0284c7] hover:bg-[#0ea5e9] hover:text-white hover:-translate-y-0.5 hover:shadow-[3px_3px_0px_0px_#0284c7] active:translate-y-0 active:shadow-[1px_1px_0px_0px_#0284c7] transition-all whitespace-nowrap">
                {link.name}
              </a>
            ))}
          </div>
          {/* 版权 + 备案 */}
          <div class="font-bold">
            <span>{infoConfig.footer.copyrightText}</span>
            {infoConfig.footer.icp.text && <>
              <span class="mx-1.5 text-slate-400">·</span>
              <a href={infoConfig.footer.icp.link} target="_blank" rel="noopener noreferrer" class="text-[#0284c7] hover:underline">{infoConfig.footer.icp.text}</a>
            </>}
          </div>
          <div>
            <span>{footerConfig.repoText}</span><a href={footerConfig.repoUrl} class="hover:text-[#0ea5e9] underline font-bold">{footerConfig.repoDisplayName}</a>
            {(() => {
              try {
                const log = execSync('git log -n 1 --pretty=format:"%h||%ci"').toString().trim();
                const [hash, dateRaw] = log.split('||');
                const d = dateRaw ? new Date(dateRaw) : null;
                const formattedDate = d
                  ? `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`
                  : '';
                return <>
                  <span class="mx-1">·</span>
                  <a href={`${footerConfig.repoUrl}/commit/${hash}`} class="hover:text-[#0ea5e9] underline font-bold">{hash}</a>
                  {formattedDate && <><span class="mx-0.5">·</span><span>{formattedDate}</span></>}
                </>;
              } catch (e) {
                console.warn('[Layout] Git info unavailable at build time');
                return null;
              }
            })()}
          </div>
          <div class="font-bold">
            本站文章与说说累计 <span class="text-[#0284c7]">{wordCountK}k 字</span>
          </div>
          <div id="footer-uptime" class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400">
            本站已在互联网中航行 <span id="uptime-display" class="font-bold text-[#0284c7]">计算中...</span>
          </div>
          <div class="mt-3 flex justify-center">
            <a href="https://www.blogsclub.org/rank.html" target="_blank" rel="noopener noreferrer">
              <img src="https://www.blogsclub.org/badge/upxuu.com"
                   style="height:60px!important" loading="lazy" alt="BlogsClub" />
            </a>
          </div>
        </div>
      </footer>
      )}
    </div>

<script>
  if (!window._uptimeStarted) {
    window._uptimeStarted = true;
    const start = new Date(2025, 8, 30, 20, 20, 0);
    setInterval(function() {
      const el = document.getElementById('uptime-display');
      if (!el) return;
      const diff = (Date.now() - start.getTime()) / 1000;
      const days = Math.floor(diff / 86400);
      const hours = Math.floor((diff % 86400) / 3600);
      const mins = Math.floor((diff % 3600) / 60);
      const secs = Math.floor(diff % 60);
      el.textContent = days + '\u5929' + String(hours).padStart(2,'0') + '\u5c0f\u65f6' + String(mins).padStart(2,'0') + '\u5206' + String(secs).padStart(2,'0') + '\u79d2';
    }, 1000);
  }
</script>
<script is:inline>
  (function () {
    function applySiteBg() {
      var el = document.getElementById('site-bg');
      if (!el) return;
      var loader = document.getElementById('site-bg-loader');
      var isArticle = document.body && document.body.dataset.isArticle === 'true';
      if (isArticle) {
        el.style.backgroundImage = 'none';
        el.removeAttribute('data-bg-url');
        el.classList.add('is-ready');
        if (loader) loader.classList.remove('is-on');
        return;
      }
      var url = document.body && document.body.getAttribute('data-bg-url');
      if (!url) {
        el.style.backgroundImage =
          'radial-gradient(circle, rgba(253,246,227,0.35) 1px, transparent 1px)';
        el.style.backgroundSize = '24px 24px';
        el.style.backgroundPosition = '0 0';
        el.style.backgroundRepeat = 'repeat';
        el.style.backgroundAttachment = 'scroll';
        el.classList.add('is-ready');
        if (loader) loader.classList.remove('is-on');
        return;
      }

      if (el.dataset.bgUrl === url && el.classList.contains('is-ready')) {
        if (loader) loader.classList.remove('is-on');
        return;
      }

      // Keep the current CSS background in place and only re-paint it with
      // the same image instead of swapping to an empty dot grid first.
      el.dataset.bgUrl = url;
      paintBg();

      function paintBg() {
        el.style.backgroundImage =
          'radial-gradient(circle, rgba(253,246,227,0.35) 1px, transparent 1px),' +
          'linear-gradient(rgba(250,248,245,0.45), rgba(250,248,245,0.45)),' +
          'url(' + url + ')';
        el.style.backgroundSize = '24px 24px, cover, cover';
        el.style.backgroundPosition = '0 0, center, center';
        el.style.backgroundRepeat = 'repeat, no-repeat, no-repeat';
        el.style.backgroundAttachment = 'scroll, scroll, scroll';
        el.classList.add('is-ready');
        if (loader) loader.classList.remove('is-on');
      }

      var bgPromise = new Promise(function (resolve) {
        var img = new Image();
        img.onload = function () {
          el.dataset.bgUrl = url;
          paintBg();
          resolve();
        };
        img.onerror = function () {
          el.style.backgroundImage =
            'radial-gradient(circle, rgba(253,246,227,0.35) 1px, transparent 1px),' +
            'linear-gradient(rgba(250,248,245,0.55), rgba(250,248,245,0.55))';
          el.style.backgroundSize = '24px 24px, cover';
          el.style.backgroundPosition = '0 0, center';
          el.style.backgroundRepeat = 'repeat, no-repeat';
          el.style.backgroundAttachment = 'scroll, scroll';
          el.classList.add('is-ready');
          if (loader) loader.classList.remove('is-on');
          resolve();
        };
        img.src = url;
        if (img.complete) {
          el.dataset.bgUrl = url;
          paintBg();
          resolve();
        }
      });
      if (typeof window.__xuhomeTrackResource === 'function') {
        window.__xuhomeTrackResource(bgPromise);
      } else {
        window.__xuhomePendingRes = window.__xuhomePendingRes || [];
        window.__xuhomePendingRes.push(bgPromise);
      }
    }

    function onPage() {
      applySiteBg();
    }

    applySiteBg();
    if (!window.__xuhomeBgBeatInited) {
      window.__xuhomeBgBeatInited = true;
      document.addEventListener('astro:after-swap', applySiteBg);
      document.addEventListener('astro:page-load', onPage);
    }
  })();
</script>
<script>
  (function () {
    var totalRes = 0;
    var doneRes = 0;
    var hideTimer = null;

    function setProgressUI(done, total) {
      var top = document.getElementById('resource-progress');
      var topBar = top && top.querySelector('i');
      var topMeta = document.getElementById('resource-progress-meta');
      var entryBar = document.getElementById('site-bg-loader-bar');
      var entryMeta = document.getElementById('site-bg-loader-meta');
      // never show empty 0/0
      if (!total || total <= 0) {
        if (top) top.classList.remove('is-on');
        if (topBar) topBar.style.width = '0%';
        if (topMeta) { topMeta.hidden = true; topMeta.textContent = ''; }
        if (entryBar) entryBar.style.width = '0%';
        if (entryMeta) { entryMeta.hidden = true; entryMeta.textContent = ''; }
        return;
      }
      var pct = Math.min(100, Math.round((done / total) * 100));
      var label = done + ' / ' + total + ' · ' + pct + '%';
      if (topBar) topBar.style.width = pct + '%';
      if (entryBar) entryBar.style.width = pct + '%';
      if (topMeta) { topMeta.hidden = false; topMeta.textContent = label; }
      if (entryMeta) { entryMeta.hidden = false; entryMeta.textContent = label; }
      if (top) {
        if (done < total) {
          top.classList.add('is-on');
        } else {
          // snap to 100% then hide
          if (topBar) topBar.style.width = '100%';
          if (entryBar) entryBar.style.width = '100%';
          if (topMeta) topMeta.textContent = total + ' / ' + total + ' · 100%';
          if (entryMeta) entryMeta.textContent = total + ' / ' + total + ' · 100%';
          clearTimeout(hideTimer);
          hideTimer = setTimeout(function () {
            if (top) top.classList.remove('is-on');
            if (topMeta) topMeta.hidden = true;
            if (entryMeta) entryMeta.hidden = true;
          }, 320);
        }
      }
    }

    function bumpDone() {
      doneRes = Math.min(totalRes, doneRes + 1);
      setProgressUI(doneRes, totalRes);
    }

    function trackResource(promiseLike) {
      totalRes += 1;
      setProgressUI(doneRes, totalRes);
      Promise.resolve(promiseLike).then(bumpDone, bumpDone);
    }

    window.__xuhomeTrackResource = trackResource;
    if (window.__xuhomePendingRes && window.__xuhomePendingRes.length) {
      var pending = window.__xuhomePendingRes.slice();
      window.__xuhomePendingRes = [];
      for (var pi = 0; pi < pending.length; pi++) trackResource(pending[pi]);
    }

    function scan(root) {
      if (!root || !root.querySelectorAll) return;
      var els = root.querySelectorAll('img, iframe, video');
      for (var i = 0; i < els.length; i++) {
        (function (el) {
          if (el.tagName === 'IMG' && el.complete) return;
          trackResource(new Promise(function (resolve) {
            el.addEventListener('load', resolve, { once: true });
            el.addEventListener('error', resolve, { once: true });
          }));
        })(els[i]);
      }
    }

    function boot() {
      scan(document);
      var mo = new MutationObserver(function (mutations) {
        for (var m = 0; m < mutations.length; m++) {
          var added = mutations[m].addedNodes;
          for (var n = 0; n < added.length; n++) {
            if (added[n].nodeType === 1) scan(added[n]);
          }
        }
      });
      try {
        mo.observe(document.documentElement, { childList: true, subtree: true });
      } catch (e) {}
    }

    document.addEventListener('astro:page-load', function () {
      totalRes = 0;
      doneRes = 0;
      setProgressUI(0, 0);
      scan(document);
    });
  })();
</script>

