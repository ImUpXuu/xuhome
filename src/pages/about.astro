---
import Layout from '../layouts/Layout.astro';
import { siteConfig, aboutConfig } from '../config/site';
import { Content } from '../config/about.md';
import ServerStatus from '../components/ServerStatus.svelte';

const skills = aboutConfig.skills;

const GITHUB_USER = siteConfig.socials.githubUser;
const BILIBILI_MID = siteConfig.socials.bilibiliMid;
const BILIBILI_SPACE = siteConfig.socials.bilibili;

interface GitHubRepo {
  name: string;
  description: string | null;
  html_url: string;
  language: string | null;
  stargazers_count: number;
  forks_count: number;
  topics: string[];
}

interface BiliVideo {
  bvid: string;
  title: string;
  cover: string;
  duration: number;
  play_count: number;
  publish_time: number;
}

let repos: GitHubRepo[] = [];
try {
  const res = await fetch(`https://api.github.com/users/${GITHUB_USER}/repos?sort=updated&per_page=100`);
  if (res.ok) {
    const data = await res.json();
    repos = data.map((r: any) => ({
      name: r.name,
      description: r.description,
      html_url: r.html_url,
      language: r.language,
      stargazers_count: r.stargazers_count,
      forks_count: r.forks_count,
      topics: r.topics || [],
    }));
  }
} catch (e) {
  console.error('Failed to fetch GitHub repos', e);
}

let biliVideos: BiliVideo[] = [];
try {
  const firstRes = await fetch(`https://uapis.cn/api/v1/social/bilibili/archives?mid=${BILIBILI_MID}&ps=30`);
  if (firstRes.ok) {
    const firstData = await firstRes.json();
    const total = firstData.total || 0;
    const firstBatch: BiliVideo[] = (firstData.videos || []).map((v: any) => ({
      bvid: v.bvid, title: v.title, cover: v.cover,
      duration: v.duration, play_count: v.play_count, publish_time: v.publish_time,
    }));
    biliVideos = firstBatch;
    const totalPages = Math.ceil(total / 30);
    for (let p = 2; p <= totalPages; p++) {
      const res = await fetch(`https://uapis.cn/api/v1/social/bilibili/archives?mid=${BILIBILI_MID}&ps=30&pn=${p}`);
      if (res.ok) {
        const data = await res.json();
        const more: BiliVideo[] = (data.videos || []).map((v: any) => ({
          bvid: v.bvid, title: v.title, cover: v.cover,
          duration: v.duration, play_count: v.play_count, publish_time: v.publish_time,
        }));
        biliVideos = biliVideos.concat(more);
      }
    }
  }
} catch (e) {
  console.error('Failed to fetch Bilibili videos', e);
}

function fmtDuration(sec: number): string {
  const m = Math.floor(sec / 60);
  const s = sec % 60;
  return `${m}:${s.toString().padStart(2, '0')}`;
}

function fmtPlayCount(n: number): string {
  if (n >= 10000) return (n / 10000).toFixed(1) + '万';
  if (n >= 1000) return (n / 1000).toFixed(1) + 'k';
  return String(n);
}

---

<Layout 
  title={aboutConfig.title}
  description={aboutConfig.description}
  keywords={['UpXuu', '关于', '个人博客', '博主']}
  isAboutPage={true}
>
  <div class="max-w-[1440px] w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <div class="max-w-5xl mx-auto space-y-10 sm:space-y-14">

      {/* Profile Header（头像 spring 弹入 + 文字逐行凝焦，参考 i 站 hero） */}
      <div class="flex flex-col md:flex-row items-center gap-8">
        <div class="w-32 h-32 md:w-40 md:h-40 rounded-sm bg-[#0ea5e9] border-4 border-[#0284c7] shadow-[4px_4px_0px_0px_#0284c7] overflow-hidden flex items-center justify-center shrink-0" data-reveal-card>
          <img src={siteConfig.avatar} alt={siteConfig.author} width="160" height="160" loading="lazy" class="w-full h-full object-cover" />
        </div>
        <div class="text-center md:text-left">
          <div data-reveal>
            <span class="px-2 py-0.5 bg-[#fde68a] text-[#0284c7] font-black text-[10px] sm:text-xs uppercase tracking-wider rounded-sm shadow-[1.5px_1.5px_0px_0px_#0284c7] border border-[#0284c7] inline-block -skew-x-6 mb-2">✨ Hello, I'm</span>
          </div>
          <h1 class="text-2xl md:text-4xl font-black text-slate-900 dark:text-white tracking-wider mb-3" data-reveal>{siteConfig.author}</h1>
          <div class="mb-4" data-reveal>
            <span class="bg-[#fde68a] px-2 py-0.5 border-2 border-[#0284c7] shadow-[2px_2px_0px_0px_#0284c7] inline-block text-lg md:text-xl font-bold text-slate-800 dark:text-slate-800 font-mono select-none">{aboutConfig.role}</span>
          </div>
          <p class="text-slate-700 dark:text-slate-300 leading-relaxed font-medium" data-reveal>
            {aboutConfig.intro}
          </p>
        </div>
      </div>

      {/* About Me (from Markdown) */}
      <section class="space-y-4">
        <div data-reveal>
          <span class="px-2 py-0.5 bg-[#fde68a] text-[#0284c7] font-black text-[10px] sm:text-xs uppercase tracking-wider rounded-sm shadow-[1.5px_1.5px_0px_0px_#0284c7] border border-[#0284c7] inline-block -skew-x-6 mb-1">About</span>
        </div>
        <h2 class="text-xl sm:text-3xl font-black font-display tracking-tight text-slate-900 dark:text-white" data-reveal>📖 ABOUT ME</h2>
        <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:text-[#0284c7] dark:prose-headings:text-[#38bdf8] prose-headings:font-bold prose-a:text-[#0ea5e9] prose-strong:text-[#0284c7] dark:prose-strong:text-[#38bdf8] prose-code:bg-slate-100 dark:prose-code:bg-slate-800 prose-code:px-1 prose-pre:border-2 prose-pre:border-[#0284c7]" data-reveal>
          <Content />
        </div>
      </section>

      {/* Bilibili Videos */}
      <section class="space-y-4">
        <div data-reveal>
          <span class="px-2 py-0.5 bg-[#fde68a] text-[#0284c7] font-black text-[10px] sm:text-xs uppercase tracking-wider rounded-sm shadow-[1.5px_1.5px_0px_0px_#0284c7] border border-[#0284c7] inline-block -skew-x-6 mb-1">Videos</span>
        </div>
        <a href={BILIBILI_SPACE} target="_blank" class="inline-flex items-center gap-2 group" data-reveal>
          <h2 class="text-xl sm:text-3xl font-black font-display tracking-tight text-slate-900 dark:text-white group-hover:text-[#0ea5e9] transition-colors">🎬 {aboutConfig.bilibiliTitle}</h2>
          <span class="text-sm text-slate-400 font-mono">({biliVideos.length})</span>
        </a>
        <div class="overflow-x-auto pb-2 custom-scrollbar">
          <div class="flex flex-nowrap gap-4 w-max" id="bili-scroll">
            {biliVideos.length === 0 && (
              <p class="text-slate-400 text-sm">暂无数据</p>
            )}
            {biliVideos.map(video => (
              <a href={`https://www.bilibili.com/video/${video.bvid}`} target="_blank" class="w-56 shrink-0 border-2 border-[#0284c7] hover:bg-[#0ea5e9] hover:text-white transition-colors shadow-[2px_2px_0px_0px_#0284c7] group" data-reveal-card>
                <div class="aspect-video overflow-hidden border-b-2 border-[#0284c7] bg-slate-100 dark:bg-slate-800">
                  <img src={video.cover} alt={video.title} width="320" height="180" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform" referrerpolicy="no-referrer" />
                </div>
                <div class="p-3">
                  <p class="font-bold text-sm leading-snug line-clamp-2 text-slate-800 dark:text-slate-100 group-hover:text-white">{video.title}</p>
                  <div class="flex items-center gap-3 mt-2 text-xs text-slate-500 dark:text-slate-400 group-hover:text-white/80">
                    <span>▶ {fmtPlayCount(video.play_count)}</span>
                    <span>⏱ {fmtDuration(video.duration)}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {/* Skills */}
        <section class="space-y-4">
          <div data-reveal>
            <span class="px-2 py-0.5 bg-[#fde68a] text-[#0284c7] font-black text-[10px] sm:text-xs uppercase tracking-wider rounded-sm shadow-[1.5px_1.5px_0px_0px_#0284c7] border border-[#0284c7] inline-block -skew-x-6 mb-1">Skills</span>
          </div>
          <h2 class="text-xl sm:text-3xl font-black font-display tracking-tight text-slate-900 dark:text-white" data-reveal>⚒️ 技能栈</h2>
          <div class="flex flex-wrap gap-3">
            {skills.map(skill => (
               <span class="bg-slate-50 dark:bg-slate-800 border-2 border-[#0284c7] px-3 py-1 font-bold text-slate-700 dark:text-slate-200 shadow-[2px_2px_0px_0px_#0284c7] hover:bg-[#0284c7] hover:text-white transition-colors cursor-default text-sm" data-reveal-card>
                 {skill}
               </span>
            ))}
          </div>
        </section>

        {/* Contact/Find Me */}
        <section class="space-y-4">
          <div data-reveal>
            <span class="px-2 py-0.5 bg-[#fde68a] text-[#0284c7] font-black text-[10px] sm:text-xs uppercase tracking-wider rounded-sm shadow-[1.5px_1.5px_0px_0px_#0284c7] border border-[#0284c7] inline-block -skew-x-6 mb-1">Contact</span>
          </div>
          <h2 class="text-xl sm:text-3xl font-black font-display tracking-tight text-slate-900 dark:text-white" data-reveal>📫 找到我</h2>
          <div class="space-y-4">
            <a href={aboutConfig.githubLink} target="_blank" class="flex items-center gap-3 p-3 border-2 border-[#0284c7] hover:bg-[#0ea5e9] hover:text-white transition-colors shadow-[2px_2px_0px_0px_#0284c7] group text-slate-800 dark:text-slate-100" data-reveal-card>
              <span class="font-black text-lg">GitHub</span>
              <span class="font-mono text-sm ml-auto opacity-70 group-hover:opacity-100">{aboutConfig.githubValue}</span>
            </a>
            <a href={aboutConfig.emailLink} class="flex items-center gap-3 p-3 border-2 border-[#0284c7] hover:bg-[#10b981] hover:text-white transition-colors shadow-[2px_2px_0px_0px_#0284c7] group text-slate-800 dark:text-slate-100" data-reveal-card>
              <span class="font-black text-lg">Email</span>
              <span class="font-mono text-sm ml-auto opacity-70 group-hover:opacity-100">{aboutConfig.emailValue}</span>
            </a>
          </div>
        </section>
      </div>

      {/* GitHub Section */}
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        {/* GitHub INFO */}
        <section class="space-y-4">
          <div data-reveal>
            <span class="px-2 py-0.5 bg-[#fde68a] text-[#0284c7] font-black text-[10px] sm:text-xs uppercase tracking-wider rounded-sm shadow-[1.5px_1.5px_0px_0px_#0284c7] border border-[#0284c7] inline-block -skew-x-6 mb-1">GitHub</span>
          </div>
          <h2 class="text-xl sm:text-3xl font-black font-display tracking-tight text-slate-900 dark:text-white" data-reveal>💫 GitHub INFO</h2>

          <div class="space-y-6" data-reveal>
            {/* About */}
            <div>
              <h3 class="font-bold text-slate-800 dark:text-slate-100 mb-1">💫 About Me:</h3>
              <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
                {aboutConfig.githubBio}
              </p>
            </div>

            {/* Socials */}
            <div>
              <h3 class="font-bold text-slate-800 dark:text-slate-100 mb-2">🌐 Socials:</h3>
              <div class="flex flex-wrap gap-2">
                <a href={siteConfig.socials.twitter} target="_blank" class="bg-slate-50 dark:bg-slate-800 border-2 border-[#0284c7] px-3 py-1 font-bold text-slate-700 dark:text-slate-200 shadow-[2px_2px_0px_0px_#0284c7] hover:bg-black hover:text-white transition-colors text-xs">𝕏</a>
                <a href={siteConfig.socials.youtube} target="_blank" class="bg-slate-50 dark:bg-slate-800 border-2 border-[#0284c7] px-3 py-1 font-bold text-slate-700 dark:text-slate-200 shadow-[2px_2px_0px_0px_#0284c7] hover:bg-red-600 hover:text-white transition-colors text-xs">YouTube</a>
                <a href={aboutConfig.socialEmailLink} class="bg-slate-50 dark:bg-slate-800 border-2 border-[#0284c7] px-3 py-1 font-bold text-slate-700 dark:text-slate-200 shadow-[2px_2px_0px_0px_#0284c7] hover:bg-red-500 hover:text-white transition-colors text-xs">Email</a>
              </div>
            </div>

            {/* GitHub Stats */}
            <div>
              <h3 class="font-bold text-slate-800 dark:text-slate-100 mb-2">📊 GitHub Stats:</h3>
              <div class="space-y-2">
                <img src={`https://github-readme-stats.shion.dev/api?username=${GITHUB_USER}&theme=graywhite&hide_border=false&include_all_commits=true&count_private=true`} alt="GitHub Stats" class="w-full max-w-md border border-slate-200 dark:border-slate-700" loading="lazy" />
                <img src={`https://streak-stats.demolab.com/?user=${GITHUB_USER}&theme=graywhite&hide_border=false`} alt="GitHub Streak" class="w-full max-w-md border border-slate-200 dark:border-slate-700" loading="lazy" />
                <img src={`https://github-readme-stats.shion.dev/api/top-langs/?username=${GITHUB_USER}&theme=graywhite&hide_border=false&include_all_commits=true&count_private=true&layout=compact`} alt="Top Langs" class="w-full max-w-md border border-slate-200 dark:border-slate-700" loading="lazy" />
              </div>
            </div>

            <div class="text-xs text-slate-400">
              <img src={`https://komarev.com/ghpvc/?username=${GITHUB_USER}&icon=4&color=0`} alt="Profile views" loading="lazy" />
            </div>
          </div>
        </section>

        {/* GitHub Repos */}
        <section class="space-y-4">
          <div data-reveal>
            <span class="px-2 py-0.5 bg-[#fde68a] text-[#0284c7] font-black text-[10px] sm:text-xs uppercase tracking-wider rounded-sm shadow-[1.5px_1.5px_0px_0px_#0284c7] border border-[#0284c7] inline-block -skew-x-6 mb-1">Repos</span>
          </div>
          <h2 class="text-xl sm:text-3xl font-black font-display tracking-tight text-slate-900 dark:text-white" data-reveal>📦 仓库列表 <span class="text-sm text-slate-400 font-mono align-middle">({repos.length})</span></h2>
          <div class="overflow-x-auto pb-2 custom-scrollbar">
            <div class="flex flex-nowrap gap-4 w-max">
              {repos.length === 0 && (
                <p class="text-slate-400 text-sm">暂无数据</p>
              )}
              {repos.map(repo => (
                <a href={repo.html_url} target="_blank" class="w-64 shrink-0 p-4 border-2 border-[#0284c7] hover:bg-[#0ea5e9] hover:text-white transition-colors shadow-[2px_2px_0px_0px_#0284c7] group bg-white dark:bg-slate-800" data-reveal-card>
                  <div class="flex items-start justify-between gap-2">
                    <span class="font-bold text-sm truncate group-hover:text-white text-slate-800 dark:text-slate-100">{repo.name}</span>
                    <div class="flex items-center gap-2 text-xs shrink-0 text-slate-500 dark:text-slate-400 group-hover:text-white/80">
                      {repo.stargazers_count > 0 && <span>⭐ {repo.stargazers_count}</span>}
                      {repo.forks_count > 0 && <span>⑂ {repo.forks_count}</span>}
                    </div>
                  </div>
                  {repo.description && (
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2 group-hover:text-white/80">{repo.description}</p>
                  )}
                  <div class="flex items-center gap-2 mt-2">
                    {repo.language && (
                      <span class="text-[10px] font-mono bg-slate-100 dark:bg-slate-700 px-1.5 py-0.5 border border-slate-300 dark:border-slate-600 group-hover:bg-white/20 group-hover:border-white/30 group-hover:text-white/90 text-slate-600 dark:text-slate-300">{repo.language}</span>
                    )}
                    {repo.topics?.slice(0, 2).map(topic => (
                      <span class="text-[10px] bg-[#e0f2fe] dark:bg-slate-700 text-[#0284c7] dark:text-[#7dd3fc] px-1.5 py-0.5 border border-[#0284c7] dark:border-slate-600 group-hover:bg-white/20 group-hover:text-white/90">{topic}</span>
                    ))}
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>

        <ServerStatus client:load />

      </div>

    </div>
  </div>
</Layout>
