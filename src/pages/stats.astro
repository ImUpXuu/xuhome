---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
---

<Layout
  title={`网站统计${siteConfig.titleTemplate}`}
  description="UpXuu 博客访问统计：24 小时请求趋势、页面访问排行"
  hideBanner={true}
>
  <div class="w-full max-w-6xl mx-auto px-2 sm:px-4 pb-24">
    <!-- 标题区 -->
    <div class="mb-6 flex items-center justify-between gap-3">
      <div>
        <h1 class="text-xl sm:text-2xl font-black text-[#0284c7]">📊 网站统计</h1>
        <p class="text-xs sm:text-sm font-bold text-slate-500 dark:text-slate-400 mt-1">数据来自 Umami · 每 60 秒刷新</p>
      </div>
      <span class="text-xs font-black text-slate-400 bg-white dark:bg-slate-800 border-2 border-[#0284c7] px-3 py-1.5 rounded-sm shadow-[2px_2px_0px_0px_#0284c7]" id="update-time">--:--</span>
    </div>

    <!-- 总览卡 -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6" id="totals">
      <div class="bg-white dark:bg-slate-800 border-2 border-[#0284c7] rounded-sm p-4 shadow-[3px_3px_0px_0px_#0284c7]">
        <div class="text-[11px] font-black text-slate-400 uppercase tracking-wider">今日 PV</div>
        <div class="text-2xl font-black text-[#0284c7] tabular-nums" id="total-pv">-</div>
      </div>
      <div class="bg-white dark:bg-slate-800 border-2 border-[#0284c7] rounded-sm p-4 shadow-[3px_3px_0px_0px_#0284c7]">
        <div class="text-[11px] font-black text-slate-400 uppercase tracking-wider">今日 UV</div>
        <div class="text-2xl font-black text-[#0284c7] tabular-nums" id="total-uv">-</div>
      </div>
      <div class="bg-white dark:bg-slate-800 border-2 border-[#0284c7] rounded-sm p-4 shadow-[3px_3px_0px_0px_#0284c7]">
        <div class="text-[11px] font-black text-slate-400 uppercase tracking-wider">访问次数</div>
        <div class="text-2xl font-black text-[#0284c7] tabular-nums" id="total-visits">-</div>
      </div>
      <div class="bg-white dark:bg-slate-800 border-2 border-[#0284c7] rounded-sm p-4 shadow-[3px_3px_0px_0px_#0284c7]">
        <div class="text-[11px] font-black text-slate-400 uppercase tracking-wider">总 PV</div>
        <div class="text-2xl font-black text-[#0284c7] tabular-nums" id="total-all">-</div>
      </div>
    </div>

    <!-- 趋势图 -->
    <div class="bg-white dark:bg-slate-800 border-2 border-[#0284c7] rounded-sm p-4 sm:p-5 shadow-[3px_3px_0px_0px_#0284c7] mb-6">
      <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
        <h2 class="text-sm font-black text-[#0284c7]">24 小时请求趋势</h2>
        <div class="flex gap-3 text-[11px] font-bold text-slate-500 dark:text-slate-400">
          <span class="flex items-center gap-1"><span class="w-3 h-1.5 inline-block bg-[#0284c7]"></span>PV</span>
          <span class="flex items-center gap-1"><span class="w-3 h-1.5 inline-block bg-[#f59e0b]"></span>UV</span>
          <span class="flex items-center gap-1"><span class="w-3 h-1.5 inline-block bg-[#10b981]"></span>Visits</span>
        </div>
      </div>
      <canvas id="trend-chart" class="w-full" height="260" style="max-height:300px"></canvas>
    </div>

    <!-- 页面排行 -->
    <div class="bg-white dark:bg-slate-800 border-2 border-[#0284c7] rounded-sm p-4 sm:p-5 shadow-[3px_3px_0px_0px_#0284c7]">
      <div class="flex items-center justify-between gap-3 mb-3">
        <h2 class="text-sm font-black text-[#0284c7]">24 小时页面访问排行</h2>
        <select id="page-range" class="text-xs font-bold text-slate-600 dark:text-slate-300 bg-white dark:bg-slate-700 border-2 border-[#0284c7] rounded-sm px-2 py-1">
          <option value="24">24 小时</option>
          <option value="168">7 天</option>
          <option value="720">30 天</option>
        </select>
      </div>
      <div id="page-list" class="space-y-1.5"></div>
    </div>
  </div>
</Layout>

<script>
  const API = 'https://blog.api.upxuu.com';
  let trendCache = null;
  let pageRange = 24;

  function $(id) { return document.getElementById(id); }

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[c]));
  }

  async function getJSON(url) {
    const r = await fetch(url, { headers: { 'Accept': 'application/json' } });
    if (!r.ok) throw new Error('HTTP ' + r.status);
    return r.json();
  }

  // ===== 绘制多线趋势图（canvas 手绘，零依赖） =====
  function drawTrend(series) {
    const canvas = $('trend-chart');
    if (!canvas || !series || !series.length) return;
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.clientWidth || 800;
    const h = 260;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    const ctx = canvas.getContext('2d');
    ctx.scale(dpr, dpr);

    const padL = 34, padR = 10, padT = 12, padB = 24;
    const plotW = w - padL - padR;
    const plotH = h - padT - padB;

    const maxVal = Math.max(1, ...series.map(s => Math.max(s.pv, s.uv, s.visits)));
    const n = series.length;

    const xAt = i => padL + (n === 1 ? plotW / 2 : (i / (n - 1)) * plotW);
    const yAt = v => padT + plotH - (v / maxVal) * plotH;

    // 网格
    ctx.strokeStyle = 'rgba(2,132,199,0.12)';
    ctx.lineWidth = 1;
    for (let g = 0; g <= 4; g++) {
      const gy = padT + (g / 4) * plotH;
      ctx.beginPath(); ctx.moveTo(padL, gy); ctx.lineTo(w - padR, gy); ctx.stroke();
      ctx.fillStyle = '#94a3b8';
      ctx.font = '10px monospace';
      ctx.textAlign = 'right';
      ctx.fillText(Math.round(maxVal * (1 - g / 4)), padL - 6, gy + 3);
    }

    // X 轴时间标签（每 ~3 个点标一个）
    ctx.fillStyle = '#94a3b8';
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    const labelStep = Math.max(1, Math.ceil(n / 8));
    for (let i = 0; i < n; i += labelStep) {
      const t = new Date(series[i].t);
      ctx.fillText(String(t.getHours()).padStart(2, '0') + ':00', xAt(i), h - 6);
    }

    // 画线（pv / uv / visits）
    const drawLine = (key, color) => {
      ctx.strokeStyle = color;
      ctx.lineWidth = 2;
      ctx.lineJoin = 'round';
      ctx.beginPath();
      series.forEach((s, i) => {
        const x = xAt(i), y = yAt(s[key] || 0);
        i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      });
      ctx.stroke();
      // 端点小圆点
      ctx.fillStyle = color;
      series.forEach((s, i) => {
        ctx.beginPath();
        ctx.arc(xAt(i), yAt(s[key] || 0), 2, 0, Math.PI * 2);
        ctx.fill();
      });
    };
    drawLine('pv', '#0284c7');
    drawLine('uv', '#f59e0b');
    drawLine('visits', '#10b981');
  }

  // ===== 渲染页面排行 =====
  function renderPages(pages, totalPv) {
    const list = $('page-list');
    if (!pages || !pages.length) {
      list.innerHTML = '<p class="text-sm text-slate-400 text-center py-6">暂无数据</p>';
      return;
    }
    const max = pages[0].views;
    list.innerHTML = pages.map((p, i) => {
      const pct = max > 0 ? Math.round((p.views / max) * 100) : 0;
      const barW = Math.max(pct, 2);
      return `
        <div class="flex items-center gap-3">
          <span class="w-6 shrink-0 text-center text-xs font-black tabular-nums ${i === 0 ? 'text-[#0284c7]' : 'text-slate-400'}">${i + 1}</span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold text-slate-700 dark:text-slate-200 truncate" title="${esc(p.path)}">${esc(p.path || '/')}</span>
              <span class="text-xs font-black text-[#0284c7] tabular-nums shrink-0">${p.views}</span>
            </div>
            <div class="mt-1 h-1.5 bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden">
              <div class="h-full bg-[#0284c7] rounded-full" style="width:${barW}%"></div>
            </div>
          </div>
        </div>`;
    }).join('');
  }

  // ===== 加载 =====
  async function loadTrend() {
    try {
      const data = await getJSON(`${API}/api/trend?hours=24`);
      trendCache = data;
      $('total-pv').textContent = data.total.pv.toLocaleString();
      $('total-uv').textContent = data.total.uv.toLocaleString();
      $('total-visits').textContent = data.total.visits.toLocaleString();
      drawTrend(data.series);
      $('update-time').textContent = new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
    } catch (e) {
      $('total-pv').textContent = '—';
      console.warn('trend load failed', e);
    }
  }

  async function loadPages() {
    try {
      const data = await getJSON(`${API}/api/pages?hours=${pageRange}&limit=20`);
      renderPages(data.pages, data.total);
    } catch (e) {
      $('page-list').innerHTML = '<p class="text-sm text-slate-400 text-center py-6">加载失败</p>';
    }
  }

  // 总 PV（全时段）
  async function loadAllTime() {
    try {
      const data = await getJSON(`${API}/api/stats`);
      $('total-all').textContent = data.pv.toLocaleString();
    } catch (e) { $('total-all').textContent = '—'; }
  }

  // 初始化
  $('page-range').addEventListener('change', (e) => {
    pageRange = Number(e.target.value);
    loadPages();
  });
  window.addEventListener('resize', () => { if (trendCache) drawTrend(trendCache.series); });

  loadTrend();
  loadPages();
  loadAllTime();
  setInterval(() => { loadTrend(); }, 60000);
</script>

<style>
  canvas { display: block; }
</style>