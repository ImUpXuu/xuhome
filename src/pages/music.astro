---
import Layout from '../layouts/Layout.astro';
import { seoConfig } from '../config/site';
---

<Layout
  title={`音乐播放器${seoConfig.titleTemplate}`}
  description="UpXuu 的博客音乐播放器"
  keywords={['UpXuu', '音乐播放器', '在线音乐', '听歌']}
  hideFooter={true}
  hideBanner={true}
>
  {/* 播放器已全局挂载在 Layout 中（transition:persist 跨页保活），此处仅提供页面路由 */}
</Layout>
