---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import historyData from '../data/history-data.json';

const { meta, commits, wordTrend, pieCounts, monthly, dailyCounts } = historyData as {
  meta: { repo: string; commitCount: number; firstCommit: string; lastCommit: string; years: number[] };
  commits: { sha: string; date: string; author: string; subject: string; files: string[]; cats: string[] }[];
  wordTrend: { m: string; v: number }[];
  pieCounts: { post: number; talk: number; friend: number; other: number };
  monthly: { m: string; count: number }[];
  dailyCounts: Record<string, number>;
};

// 默认年份：今年，否则最新一年
const now = new Date();
const defaultYear = meta.years.includes(now.getFullYear()) ? now.getFullYear() : (meta.years[meta.years.length - 1] ?? now.getFullYear());

// 把 commits 按月份分组（YYYY-MM），最新月份排前
const byMonth = new Map<string, typeof commits>();
for (const c of commits) {
  const d = new Date(c.date);
  if (isNaN(d.getTime())) continue;
  const k = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  if (!byMonth.has(k)) byMonth.set(k, []);
  byMonth.get(k)!.push(c);
}
const monthKeys = [...byMonth.keys()].sort((a, b) => b.localeCompare(a));

const totalCommits = commits.length;
const totalChars = wordTrend.length ? wordTrend[wordTrend.length - 1].v : 0;
const firstDate = meta.firstCommit ? new Date(meta.firstCommit) : null;
const lastDate = meta.lastCommit ? new Date(meta.lastCommit) : null;
const fmtDate = (d: Date | null) =>
  d ? `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}` : '-';

const pieTotal = pieCounts.post + pieCounts.talk + pieCounts.friend + pieCounts.other;
const pieSegs = [
  { key: 'post',   label: '文章', value: pieCounts.post,   color: '#0284c7' },
  { key: 'talk',   label: '说说', value: pieCounts.talk,   color: '#10b981' },
  { key: 'friend', label: '友链', value: pieCounts.friend, color: '#f59e0b' },
  { key: 'other',  label: '其他', value: pieCounts.other,  color: '#94a3b8' },
];

const repo = meta.repo;
const commitUrl = (sha: string) => `https://github.com/${repo}/commit/${sha}`;

const fmtRel = (d: Date) => {
  const diff = Math.floor((now.getTime() - d.getTime()) / 1000);
  if (diff < 60) return '刚刚';
  if (diff < 3600) return `${Math.floor(diff / 60)} 分钟前`;
  if (diff < 86400) return `${Math.floor(diff / 3600)} 小时前`;
  if (diff < 86400 * 30) return `${Math.floor(diff / 86400)} 天前`;
  if (diff < 86400 * 365) return `${Math.floor(diff / 86400 / 30)} 个月前`;
  return `${Math.floor(diff / 86400 / 365)} 年前`;
};

const dataJSON = JSON.stringify({
  repo,
  defaultYear,
  years: meta.years,
  totalCommits,
  totalChars,
  firstDate: fmtDate(firstDate),
  lastDate: fmtDate(lastDate),
  commits: commits.map((c) => ({
    sha: c.sha,
    date: c.date,
    author: c.author,
    subject: c.subject,
    files: c.files,
    cats: c.cats,
    url: commitUrl(c.sha),
  })),
  monthly,
  pieCounts,
  wordTrend,
  pieSegs,
  dailyCounts,
  monthKeys,
});
---

<Layout
  title={`更新历史${siteConfig.titleTemplate}`}
  description="UpXuu 博客的 commit 历史、热力图、字数趋势、内容占比统计"
  hideBanner={true}
>
  <div class="w-full max-w-6xl mx-auto px-2 sm:px-4 pb-24">

    <!-- 标题区 -->
    <div class="mb-5 flex items-end justify-between gap-3 flex-wrap animate-stat-in" style="--d:0s">
      <div>
        <h1 class="text-xl sm:text-2xl font-black text-[#0284c7]">📜 更新历史</h1>
        <p class="text-xs sm:text-sm font-bold text-slate-500 dark:text-slate-400 mt-1">
          构建时从 GitHub 拉取 commit · 共
          <span class="text-[#0284c7] font-black" id="meta-total-commits">{totalCommits}</span>
          次提交 ·
          <span class="text-[#f59e0b] font-black" id="meta-total-chars">{totalChars.toLocaleString()}</span>
          字
        </p>
      </div>
      <div class="flex items-center gap-2">
        <label for="year-select" class="text-xs font-black text-slate-500 dark:text-slate-400">年份</label>
        <select id="year-select" class="text-xs font-bold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border-2 border-[#0284c7] rounded-md px-2 py-1.5 cursor-pointer outline-none shadow-[2px_2px_0px_0px_#0284c7] focus:shadow-[1px_1px_0px_0px_#0284c7] focus:translate-x-[1px] focus:translate-y-[1px] transition-all">
          {meta.years.map((y) => (
            <option value={y} selected={y === defaultYear}>{y}</option>
          ))}
        </select>
        <a id="repo-link" href={`https://github.com/${repo}`} target="_blank" rel="noopener noreferrer" class="text-xs font-black text-white bg-[#0284c7] border-2 border-[#0284c7] rounded-md px-2.5 py-1.5 shadow-[2px_2px_0px_0px_#fde68a] hover:-translate-y-0.5 hover:shadow-[3px_3px_0px_0px_#fde68a] active:translate-y-0 active:shadow-[1px_1px_0px_0px_#fde68a] transition-all">
          GitHub ↗
        </a>
      </div>
    </div>

    <!-- 总览卡 -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
      <div class="hist-stat-card" style="--d:0.05s">
        <div class="text-[11px] font-black text-slate-400 uppercase tracking-wider">总提交</div>
        <div class="text-2xl font-black text-[#0284c7] tabular-nums">{totalCommits.toLocaleString()}</div>
      </div>
      <div class="hist-stat-card" style="--d:0.10s">
        <div class="text-[11px] font-black text-slate-400 uppercase tracking-wider">累计字数</div>
        <div class="text-2xl font-black text-[#f59e0b] tabular-nums">{totalChars.toLocaleString()}</div>
      </div>
      <div class="hist-stat-card" style="--d:0.15s">
        <div class="text-[11px] font-black text-slate-400 uppercase tracking-wider">首发提交</div>
        <div class="text-base font-black text-slate-700 dark:text-slate-200 tabular-nums">{fmtDate(firstDate)}</div>
      </div>
      <div class="hist-stat-card" style="--d:0.20s">
        <div class="text-[11px] font-black text-slate-400 uppercase tracking-wider">最近提交</div>
        <div class="text-base font-black text-slate-700 dark:text-slate-200 tabular-nums">{fmtDate(lastDate)}</div>
      </div>
    </div>

    <!-- 热力图 -->
    <div class="chart-card mb-5" style="--d:0.25s">
      <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
        <h2 class="text-sm font-black text-[#0284c7] flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          全年热力图
          <span class="text-[11px] font-bold text-slate-400" id="heat-year-label">{defaultYear}</span>
        </h2>
        <div class="flex items-center gap-2 text-[11px] font-bold text-slate-500 dark:text-slate-400 select-none">
          <span>少</span>
          <span class="w-3 h-3 rounded-sm inline-block heat-swatch" data-level="0"></span>
          <span class="w-3 h-3 rounded-sm inline-block heat-swatch" data-level="1"></span>
          <span class="w-3 h-3 rounded-sm inline-block heat-swatch" data-level="2"></span>
          <span class="w-3 h-3 rounded-sm inline-block heat-swatch" data-level="3"></span>
          <span class="w-3 h-3 rounded-sm inline-block heat-swatch" data-level="4"></span>
          <span>多</span>
        </div>
      </div>
      <div id="heat-container" class="overflow-x-auto custom-scrollbar pb-1"></div>
      <div id="heat-tip" class="absolute hidden pointer-events-none z-20 rounded-md bg-slate-900/90 text-white text-xs px-2.5 py-1.5 shadow-xl backdrop-blur-sm whitespace-nowrap"></div>
    </div>

    <!-- 三图：月度柱状 / 占比饼 / 字数趋势 -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-5">
      <div class="chart-card" style="--d:0.30s">
        <h2 class="text-sm font-black text-[#0284c7] flex items-center gap-2 mb-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/></svg>
          各月提交数
          <span class="text-[11px] font-bold text-slate-400 ml-auto" id="month-year-label">{defaultYear}</span>
        </h2>
        <div class="relative">
          <canvas id="month-chart" height="220" class="w-full block"></canvas>
          <div id="month-tip" class="absolute hidden pointer-events-none z-10 rounded-md bg-slate-900/90 text-white text-xs px-2.5 py-1.5 shadow-xl backdrop-blur-sm whitespace-nowrap"></div>
        </div>
      </div>

      <div class="chart-card" style="--d:0.35s">
        <h2 class="text-sm font-black text-[#0284c7] flex items-center gap-2 mb-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path stroke-linecap="round" stroke-linejoin="round" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg>
          更新内容占比
        </h2>
        <div class="relative flex items-center justify-center" style="min-height: 200px;">
          <canvas id="pie-chart" width="220" height="220" class="block"></canvas>
          <div id="pie-tip" class="absolute hidden pointer-events-none z-10 rounded-md bg-slate-900/90 text-white text-xs px-2.5 py-1.5 shadow-xl backdrop-blur-sm whitespace-nowrap"></div>
        </div>
        <div class="mt-3 grid grid-cols-2 gap-1.5 text-[11px] font-bold">
          {pieSegs.map((s) => (
            <div class="flex items-center gap-1.5 text-slate-600 dark:text-slate-300">
              <span class="w-2.5 h-2.5 rounded-sm inline-block shrink-0" style={`background:${s.color}`}></span>
              <span>{s.label}</span>
              <span class="ml-auto tabular-nums text-[#0284c7]">{s.value.toLocaleString()}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="chart-card" style="--d:0.40s">
        <h2 class="text-sm font-black text-[#0284c7] flex items-center gap-2 mb-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          累计字数趋势
        </h2>
        <div class="relative">
          <canvas id="word-chart" height="220" class="w-full block cursor-crosshair"></canvas>
          <div id="word-tip" class="absolute hidden pointer-events-none z-10 rounded-md bg-slate-900/90 text-white text-xs px-2.5 py-1.5 shadow-xl backdrop-blur-sm whitespace-nowrap"></div>
        </div>
      </div>
    </div>

    <!-- Commit 历史（按月折叠） -->
    <div class="chart-card" style="--d:0.45s">
      <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
        <h2 class="text-sm font-black text-[#0284c7] flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
          Commit 历史
          <span class="text-[11px] font-bold text-slate-400">共 <span id="commit-total">{totalCommits}</span> 条</span>
        </h2>
        <div class="flex gap-2 text-[11px]">
          <button id="expand-all" class="font-black text-[#0284c7] border-2 border-[#0284c7] rounded-md px-2.5 py-1 bg-white dark:bg-slate-800 shadow-[1px_1px_0px_0px_#0284c7] hover:bg-[#fde68a] transition-colors">全部展开</button>
          <button id="collapse-all" class="font-black text-slate-500 border-2 border-slate-300 dark:border-slate-600 rounded-md px-2.5 py-1 bg-white dark:bg-slate-800 hover:text-[#0284c7] hover:border-[#0284c7] transition-colors">全部收起</button>
        </div>
      </div>
      <div id="month-list" class="space-y-3"></div>
    </div>
  </div>

  <div id="hist-data" data-json={dataJSON} hidden></div>
</Layout>

<style>
  .hist-stat-card {
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(6px);
    border: 1.5px solid rgba(2, 132, 199, 0.22);
    border-radius: 14px;
    padding: 14px 16px;
    animation: hist-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0s);
    transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
  }
  .hist-stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(2,132,199,.15); background: rgba(255,255,255,.8); }
  @media (prefers-color-scheme: dark) {
    .hist-stat-card { background: rgba(30, 41, 59, 0.55); border-color: rgba(2, 132, 199, 0.4); }
    .hist-stat-card:hover { background: rgba(30, 41, 59, 0.8); }
  }

  .chart-card {
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(8px);
    border: 1.5px solid rgba(2, 132, 199, 0.22);
    border-radius: 16px;
    padding: 16px 18px;
    box-shadow: 0 4px 18px rgba(2, 132, 199, 0.06);
    animation: hist-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0s);
  }
  @media (prefers-color-scheme: dark) {
    .chart-card { background: rgba(30, 41, 59, 0.55); border-color: rgba(2, 132, 199, 0.4); }
  }

  @keyframes hist-in {
    from { opacity: 0; transform: translateY(22px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .heat-swatch[data-level="0"] { background: rgba(2, 132, 199, 0.07); }
  .heat-swatch[data-level="1"] { background: rgba(2, 132, 199, 0.30); }
  .heat-swatch[data-level="2"] { background: rgba(2, 132, 199, 0.55); }
  .heat-swatch[data-level="3"] { background: rgba(2, 132, 199, 0.80); }
  .heat-swatch[data-level="4"] { background: #0284c7; }

  /* GitHub-like heatmap cells */
  .heat-grid { display: grid; grid-template-rows: repeat(7, 1fr); grid-auto-flow: column; gap: 3px; }
  .heat-cell {
    width: 12px; height: 12px; border-radius: 2px;
    background: rgba(2, 132, 199, 0.07);
    cursor: pointer;
    transition: transform .12s ease;
  }
  .heat-cell:hover { transform: scale(1.4); outline: 1.5px solid #0284c7; }
  @media (min-width: 640px) { .heat-cell { width: 14px; height: 14px; } }

  .heat-month-label {
    font-size: 10px; color: #64748b; font-weight: 700;
    grid-row: 1; grid-column: span 1;
  }
  .heat-weekday-label {
    font-size: 10px; color: #94a3b8; font-weight: 600;
    width: 22px; text-align: right;
  }

  .commit-row {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 10px;
    align-items: start;
    padding: 10px 12px;
    border-radius: 8px;
    transition: background .15s ease;
  }
  .commit-row:hover { background: rgba(2, 132, 199, 0.06); }
  @media (max-width: 640px) {
    .commit-row { grid-template-columns: 1fr; gap: 4px; }
  }
  .commit-sha {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px; font-weight: 700;
    color: #0284c7;
  }
  .commit-sha:hover { text-decoration: underline; }
  .commit-subject {
    font-size: 13px; font-weight: 600;
    color: rgb(51 65 85);
    line-height: 1.55;
    word-break: break-word;
  }
  :global(.dark) .commit-subject { color: rgb(226 232 240); }
  .commit-date {
    font-size: 11px; font-weight: 700;
    color: #64748b;
    white-space: nowrap;
  }
  .commit-files {
    grid-column: 2 / -1;
    margin-top: 4px;
    display: flex; flex-wrap: wrap; gap: 4px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
  }
  .commit-file {
    background: rgba(2, 132, 199, 0.08);
    color: #0284c7;
    padding: 1px 6px;
    border-radius: 3px;
    border: 1px solid rgba(2, 132, 199, 0.18);
    max-width: 320px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  :global(.dark) .commit-file { background: rgba(2, 132, 199, 0.18); }

  .cat-tag {
    font-size: 9px; font-weight: 800;
    padding: 1px 5px;
    border-radius: 3px;
    margin-right: 4px;
    letter-spacing: 0.5px;
  }
  .cat-post { background: rgba(2, 132, 199, 0.15); color: #0284c7; }
  .cat-talk { background: rgba(16, 185, 129, 0.15); color: #10b981; }
  .cat-friend { background: rgba(245, 158, 11, 0.18); color: #d97706; }
  .cat-other { background: rgba(148, 163, 184, 0.22); color: #64748b; }
  :global(.dark) .cat-friend { color: #fbbf24; }

  .month-block {
    border: 1.5px solid rgba(2, 132, 199, 0.18);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.35);
    overflow: hidden;
  }
  :global(.dark) .month-block { background: rgba(30, 41, 59, 0.35); border-color: rgba(2, 132, 199, 0.32); }
  .month-header {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px;
    cursor: pointer;
    user-select: none;
    transition: background .15s ease;
  }
  .month-header:hover { background: rgba(2, 132, 199, 0.05); }
  .month-chev {
    width: 18px; height: 18px;
    color: #0284c7;
    transition: transform .2s ease;
    flex-shrink: 0;
  }
  .month-block.open .month-chev { transform: rotate(90deg); }
  .month-title {
    font-size: 14px; font-weight: 900; color: #0284c7;
  }
  .month-meta {
    margin-left: auto;
    font-size: 11px; font-weight: 700;
    color: #64748b;
  }
  .month-body {
    max-height: 0; overflow: hidden;
    transition: max-height .35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .month-block.open .month-body { max-height: 6000px; }
  .month-body-inner {
    padding: 6px 8px 12px 8px;
    border-top: 1px dashed rgba(2, 132, 199, 0.18);
    display: flex; flex-direction: column; gap: 2px;
  }

  .custom-scrollbar::-webkit-scrollbar { height: 6px; width: 6px; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(2, 132, 199, 0.35); border-radius: 3px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
</style>

<script>
  type Commit = {
    sha: string; date: string; author: string; subject: string;
    files: string[]; cats: string[]; url: string;
  };

  const raw = (document.getElementById('hist-data') as HTMLElement | null)?.dataset.json || '{}';
  const data = JSON.parse(raw) as {
    repo: string; defaultYear: number; years: number[];
    totalCommits: number; totalChars: number;
    firstDate: string; lastDate: string;
    commits: Commit[];
    monthly: { m: string; count: number }[];
    pieCounts: { post: number; talk: number; friend: number; other: number };
    wordTrend: { m: string; v: number }[];
    pieSegs: { key: string; label: string; value: number; color: string }[];
    dailyCounts: Record<string, number>;
    monthKeys: string[];
  };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const esc = (s: string) => String(s ?? '').replace(/[&<>"']/g, (c) => ({
    '&': '&amp;',
    '<': '<lt;',
    '>': '>gt;',
    '"': '"quot;',
    "'": '&#39;'
  }[c]!));
  const fmtNum = (n: number) => n.toLocaleString();

  const CAT_LABEL: Record<string, string> = { post: '文', talk: '说', friend: '友', other: '它' };
  const CAT_CLASS: Record<string, string> = { post: 'cat-post', talk: 'cat-talk', friend: 'cat-friend', other: 'cat-other' };

  // ============ 工具 ============
  function dateKey(d: Date) {
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }
  function relTime(iso: string): string {
    const d = new Date(iso);
    const diff = Math.floor((Date.now() - d.getTime()) / 1000);
    if (diff < 60) return '刚刚';
    if (diff < 3600) return `${Math.floor(diff / 60)} 分钟前`;
    if (diff < 86400) return `${Math.floor(diff / 3600)} 小时前`;
    if (diff < 86400 * 30) return `${Math.floor(diff / 86400)} 天前`;
    if (diff < 86400 * 365) return `${Math.floor(diff / 86400 / 30)} 个月前`;
    return `${Math.floor(diff / 86400 / 365)} 年前`;
  }

  // ============ 热力图 ============
  function pickLevel(v: number, max: number): number {
    if (!v || v <= 0) return 0;
    if (max <= 1) return v ? 4 : 0;
    const r = v / max;
    if (r <= 0.25) return 1;
    if (r <= 0.5) return 2;
    if (r <= 0.75) return 3;
    return 4;
  }

  function renderHeatmap(year: number) {
    const root = $('heat-container');
    const tip = $('heat-tip');
    if (!root || !tip) return;

    const start = new Date(year, 0, 1);
    const end = new Date(year, 11, 31);

    // 计算最大当日提交数（用于着色）
    let maxDay = 0;
    for (const [k, v] of Object.entries(data.dailyCounts)) {
      if (k.startsWith(String(year))) maxDay = Math.max(maxDay, v);
    }

    // GitHub 风格：列=周，行=星期；最左列可能从周日开始
    // 我们以周一为行首（更符合中文使用习惯）
    const firstDay = new Date(start);
    const offset = (firstDay.getDay() + 6) % 7; // 周一=0
    const firstSunday = new Date(start);
    firstSunday.setDate(start.getDate() - offset);

    // 共 53 列（年最多跨 53 周）
    const totalDays = Math.ceil((end.getTime() - firstSunday.getTime()) / 86400000) + 1;
    const totalCols = Math.ceil(totalDays / 7);

    const weekdayLabels = ['一', '三', '五'];
    const monthNames = ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月'];

    let html = '<div class="flex gap-2">';
    // 星期标签
    html += '<div class="flex flex-col gap-[3px] pt-[18px] shrink-0">';
    for (let i = 0; i < 7; i++) {
      const visible = i === 0 || i === 2 || i === 4;
      html += `<div class="heat-weekday-label" style="visibility:${visible ? 'visible' : 'hidden'};height:14px;line-height:14px">${visible ? weekdayLabels[i / 2] : ''}</div>`;
    }
    html += '</div>';

    html += '<div class="flex-1 min-w-0">';
    // 月份标签行
    html += '<div style="display:grid;grid-template-columns:repeat(' + totalCols + ', 1fr);gap:3px;margin-bottom:4px;height:14px;position:relative;">';
    let lastMonth = -1;
    for (let col = 0; col < totalCols; col++) {
      const firstDayOfCol = new Date(firstSunday);
      firstDayOfCol.setDate(firstSunday.getDate() + col * 7);
      const m = firstDayOfCol.getMonth();
      const day = firstDayOfCol.getDate();
      if (day <= 7 && m !== lastMonth) {
        html += `<div class="heat-month-label" style="grid-column:${col + 1}">${monthNames[m]}</div>`;
        lastMonth = m;
      } else {
        html += '<div></div>';
      }
    }
    html += '</div>';

    // 网格
    html += `<div class="heat-grid" style="grid-template-columns:repeat(${totalCols}, 1fr)">`;
    for (let col = 0; col < totalCols; col++) {
      for (let row = 0; row < 7; row++) {
        const cellDate = new Date(firstSunday);
        cellDate.setDate(firstSunday.getDate() + col * 7 + row);
        const inYear = cellDate.getFullYear() === year;
        if (!inYear) {
          html += '<div class="heat-cell" style="visibility:hidden"></div>';
          continue;
        }
        const k = dateKey(cellDate);
        const v = data.dailyCounts[k] || 0;
        const lvl = pickLevel(v, maxDay);
        html += `<div class="heat-cell" data-level="${lvl}" data-date="${k}" data-count="${v}" style="grid-row:${row + 1}"></div>`;
      }
    }
    html += '</div></div></div>';

    root.innerHTML = html;

    const cells = root.querySelectorAll<HTMLElement>('.heat-cell[data-date]');
    cells.forEach((cell) => {
      cell.addEventListener('mouseenter', (e) => {
        const date = cell.dataset.date!;
        const count = cell.dataset.count || '0';
        tip.innerHTML = `<b>${date}</b> · ${count} 次提交`;
        tip.classList.remove('hidden');
        const rect = (cell as HTMLElement).getBoundingClientRect();
        const cardRect = root.getBoundingClientRect();
        const tipX = rect.left - cardRect.left + rect.width / 2;
        tip.style.left = tipX + 'px';
        tip.style.top = (rect.top - cardRect.top - 32) + 'px';
        tip.style.transform = 'translateX(-50%)';
      });
      cell.addEventListener('mouseleave', () => tip.classList.add('hidden'));
    });

    const label = $('heat-year-label');
    if (label) label.textContent = String(year);
  }

  // ============ 月度柱状图 ============
  function smoothPath(ctx: CanvasRenderingContext2D, pts: { x: number; y: number }[]) {
    if (!pts.length) return;
    ctx.moveTo(pts[0].x, pts[0].y);
    if (pts.length < 3) { pts.forEach((p) => ctx.lineTo(p.x, p.y)); return; }
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[Math.max(0, i - 1)]; const p1 = pts[i]; const p2 = pts[i + 1]; const p3 = pts[Math.min(pts.length - 1, i + 2)];
      ctx.bezierCurveTo(
        p1.x + (p2.x - p0.x) / 6, p1.y + (p2.y - p0.y) / 6,
        p2.x - (p3.x - p1.x) / 6, p2.y - (p3.y - p1.y) / 6,
        p2.x, p2.y,
      );
    }
  }

  function drawMonthChart(year: number) {
    const canvas = $('month-chart') as HTMLCanvasElement | null;
    const tip = $('month-tip');
    if (!canvas || !tip) return;

    // 取该年 12 个月数据
    const series: { m: string; v: number }[] = [];
    for (let i = 0; i < 12; i++) {
      const k = `${year}-${String(i + 1).padStart(2, '0')}`;
      const entry = data.monthly.find((x) => x.m === k);
      series.push({ m: k, v: entry ? entry.count : 0 });
    }

    const dpr = window.devicePixelRatio || 1;
    const w = canvas.clientWidth || 320;
    const h = Number(canvas.getAttribute('height') || 220);
    canvas.width = w * dpr; canvas.height = h * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.scale(dpr, dpr);
    const padL = 28, padR = 8, padT = 8, padB = 26;
    const plotW = w - padL - padR;
    const plotH = h - padT - padB;
    const maxV = Math.max(...series.map((s) => s.v), 1);
    const yMax = Math.ceil(maxV / 10) * 10 || 10;
    const colW = plotW / 12;

    ctx.clearRect(0, 0, w, h);

    // 网格
    ctx.strokeStyle = 'rgba(148,163,184,0.16)';
    ctx.lineWidth = 1;
    ctx.font = '10px monospace';
    ctx.fillStyle = '#94a3b8';
    ctx.textAlign = 'right';
    for (let g = 0; g <= 4; g++) {
      const gy = padT + (g / 4) * plotH;
      ctx.beginPath(); ctx.moveTo(padL, gy); ctx.lineTo(w - padR, gy); ctx.stroke();
      ctx.fillText(String(Math.round((yMax * (4 - g)) / 4)), padL - 6, gy + 3);
    }

    // X 轴标签
    ctx.textAlign = 'center';
    for (let i = 0; i < 12; i++) {
      const x = padL + colW * (i + 0.5);
      ctx.fillText(String(i + 1), x, h - 10);
    }

    // 柱
    series.forEach((s, i) => {
      const x = padL + colW * i + colW * 0.18;
      const bw = colW * 0.64;
      const bh = (s.v / yMax) * plotH;
      const y = padT + plotH - bh;
      const grad = ctx.createLinearGradient(0, y, 0, y + bh);
      grad.addColorStop(0, '#38bdf8');
      grad.addColorStop(1, '#0284c7');
      ctx.fillStyle = grad;
      ctx.beginPath();
      const r = Math.min(3, bw / 2, bh);
      ctx.moveTo(x, y + r);
      ctx.arcTo(x, y, x + r, y, r);
      ctx.arcTo(x + bw, y, x + bw, y + r, r);
      ctx.lineTo(x + bw, y + bh);
      ctx.lineTo(x, y + bh);
      ctx.closePath();
      ctx.fill();
      // 数值
      if (s.v > 0) {
        ctx.fillStyle = '#0284c7';
        ctx.font = 'bold 10px monospace';
        ctx.textAlign = 'center';
        ctx.fillText(String(s.v), x + bw / 2, y - 3);
      }
    });

    // hover 状态
    const label = $('month-year-label');
    if (label) label.textContent = String(year);
    (canvas as any).__series = series;
    (canvas as any).__plot = { padL, padR, padT, padB, plotW, plotH, colW, w, h };
    (canvas as any).__parentRect = canvas.parentElement!.getBoundingClientRect();

    canvas.onmousemove = (e) => {
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const pl = (canvas as any).__plot;
      const idx = Math.floor((x - pl.padL) / pl.colW);
      if (idx < 0 || idx >= 12) { tip.classList.add('hidden'); return; }
      const s = series[idx];
      if (s.v === 0) { tip.classList.add('hidden'); return; }
      tip.innerHTML = `<b>${year}年${idx + 1}月</b> · ${s.v} 次提交`;
      tip.classList.remove('hidden');
      const cardRect = canvas.parentElement!.getBoundingClientRect();
      tip.style.left = (pl.padL + pl.colW * (idx + 0.5)) + 'px';
      tip.style.top = '12px';
      tip.style.transform = 'translateX(-50%)';
    };
    canvas.onmouseleave = () => tip.classList.add('hidden');
  }

  // ============ 饼图 ============
  function drawPieChart() {
    const canvas = $('pie-chart') as HTMLCanvasElement | null;
    const tip = $('pie-tip');
    if (!canvas || !tip) return;

    const dpr = window.devicePixelRatio || 1;
    const cssSize = 220;
    canvas.width = cssSize * dpr; canvas.height = cssSize * dpr;
    canvas.style.width = cssSize + 'px'; canvas.style.height = cssSize + 'px';
    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.scale(dpr, dpr);
    ctx.clearRect(0, 0, cssSize, cssSize);

    const cx = cssSize / 2, cy = cssSize / 2, r = 88, ir = 56;
    const total = data.pieSegs.reduce((a, b) => a + b.value, 0);
    if (total === 0) {
      ctx.fillStyle = '#94a3b8';
      ctx.font = '12px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('暂无数据', cx, cy);
      return;
    }

    let angle = -Math.PI / 2;
    data.pieSegs.forEach((seg) => {
      if (seg.value <= 0) return;
      const a = (seg.value / total) * Math.PI * 2;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.arc(cx, cy, r, angle, angle + a);
      ctx.closePath();
      ctx.fillStyle = seg.color;
      ctx.fill();
      angle += a;
    });

    // 中空
    ctx.globalCompositeOperation = 'destination-out';
    ctx.beginPath();
    ctx.arc(cx, cy, ir, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalCompositeOperation = 'source-over';

    // 中心文字
    ctx.fillStyle = '#0284c7';
    ctx.font = 'bold 22px ui-monospace, monospace';
    ctx.textAlign = 'center';
    ctx.fillText(fmtNum(total), cx, cy - 2);
    ctx.fillStyle = '#94a3b8';
    ctx.font = 'bold 10px sans-serif';
    ctx.fillText('总变更', cx, cy + 14);

    // hover 检测
    canvas.onmousemove = (e) => {
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left - cx;
      const y = e.clientY - rect.top - cy;
      const dist = Math.sqrt(x * x + y * y);
      if (dist < ir || dist > r) { tip.classList.add('hidden'); return; }
      let a = Math.atan2(y, x);
      if (a < -Math.PI / 2) a += Math.PI * 2;
      let start = -Math.PI / 2;
      const target = Math.floor(((a - start) + Math.PI * 2) % (Math.PI * 2) / (Math.PI * 2) * total);
      let acc = 0;
      let seg = data.pieSegs[0];
      for (const s of data.pieSegs) {
        acc += s.value;
        if (target < acc) { seg = s; break; }
      }
      const pct = ((seg.value / total) * 100).toFixed(1);
      tip.innerHTML = `<span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:${seg.color};margin-right:5px"></span><b>${seg.label}</b> · ${fmtNum(seg.value)} (${pct}%)`;
      tip.classList.remove('hidden');
      const cardRect = canvas.parentElement!.getBoundingClientRect();
      tip.style.left = (rect.left - cardRect.left + rect.width / 2) + 'px';
      tip.style.top = '12px';
      tip.style.transform = 'translateX(-50%)';
    };
    canvas.onmouseleave = () => tip.classList.add('hidden');
  }

  // ============ 字数趋势 ============
  function drawWordChart() {
    const canvas = $('word-chart') as HTMLCanvasElement | null;
    const tip = $('word-tip');
    if (!canvas || !tip) return;

    const series = data.wordTrend;
    if (!series.length) {
      const ctx = canvas.getContext('2d')!;
      const dpr = window.devicePixelRatio || 1;
      const w = canvas.clientWidth || 320;
      const h = 220;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.scale(dpr, dpr);
      ctx.fillStyle = '#94a3b8';
      ctx.font = '12px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('暂无数据', w / 2, h / 2);
      return;
    }

    const dpr = window.devicePixelRatio || 1;
    const w = canvas.clientWidth || 320;
    const h = Number(canvas.getAttribute('height') || 220);
    canvas.width = w * dpr; canvas.height = h * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.scale(dpr, dpr);

    const padL = 40, padR = 10, padT = 12, padB = 26;
    const plotW = w - padL - padR;
    const plotH = h - padT - padB;
    const maxV = Math.max(...series.map((s) => s.v), 1);
    const yMax = Math.ceil(maxV / 1000) * 1000 || 1000;
    const n = series.length;
    const xAt = (i: number) => padL + (n === 1 ? plotW / 2 : (i / (n - 1)) * plotW);
    const yAt = (v: number) => padT + plotH - ((v / yMax) * plotH);

    ctx.clearRect(0, 0, w, h);

    // 网格
    ctx.strokeStyle = 'rgba(148,163,184,0.16)';
    ctx.lineWidth = 1;
    ctx.font = '10px monospace';
    ctx.fillStyle = '#94a3b8';
    ctx.textAlign = 'right';
    for (let g = 0; g <= 5; g++) {
      const gy = padT + (g / 5) * plotH;
      ctx.beginPath(); ctx.moveTo(padL, gy); ctx.lineTo(w - padR, gy); ctx.stroke();
      const v = Math.round((yMax * (5 - g)) / 5);
      ctx.fillText(v >= 1000 ? (v / 1000).toFixed(1) + 'k' : String(v), padL - 6, gy + 3);
    }

    // X 轴标签（按年份显示）
    ctx.textAlign = 'center';
    let lastY = -1;
    for (let i = 0; i < n; i++) {
      const y = parseInt(series[i].m.split('-')[0], 10);
      const m = parseInt(series[i].m.split('-')[1], 10);
      if (y !== lastY && m === 1) {
        ctx.fillText(String(y), xAt(i), h - 8);
        lastY = y;
      } else if (i === 0) {
        ctx.fillText(String(y), xAt(i), h - 8);
        lastY = y;
      } else if (i === n - 1) {
        ctx.fillText(String(y), xAt(i), h - 8);
      }
    }

    // 面积渐变
    const pts = series.map((s, i) => ({ x: xAt(i), y: yAt(s.v) }));
    const grad = ctx.createLinearGradient(0, padT, 0, padT + plotH);
    grad.addColorStop(0, 'rgba(245, 158, 11, 0.30)');
    grad.addColorStop(1, 'rgba(245, 158, 11, 0)');
    ctx.beginPath();
    smoothPath(ctx, pts);
    ctx.lineTo(pts[pts.length - 1].x, padT + plotH);
    ctx.lineTo(pts[0].x, padT + plotH);
    ctx.closePath();
    ctx.fillStyle = grad;
    ctx.fill();

    // 曲线
    ctx.strokeStyle = '#f59e0b';
    ctx.lineWidth = 2.2;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.beginPath();
    smoothPath(ctx, pts);
    ctx.stroke();

    // 数据点
    pts.forEach((p) => {
      ctx.beginPath();
      ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
      ctx.fillStyle = '#fff';
      ctx.fill();
      ctx.strokeStyle = '#f59e0b';
      ctx.lineWidth = 1.4;
      ctx.stroke();
    });

    // hover
    (canvas as any).__series = series;
    (canvas as any).__plot = { padL, padR, padT, padB, plotW, plotH, n };
    canvas.onmousemove = (e) => {
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const pl = (canvas as any).__plot;
      const idx = Math.round(((x - pl.padL) / pl.plotW) * (pl.n - 1));
      if (idx < 0 || idx >= pl.n) { tip.classList.add('hidden'); return; }
      const s = series[idx];
      tip.innerHTML = `<b>${s.m}</b> · ${fmtNum(s.v)} 字`;
      tip.classList.remove('hidden');
      const cardRect = canvas.parentElement!.getBoundingClientRect();
      const tx = Math.min(Math.max(x, pl.padL + 20), rect.width - 60);
      tip.style.left = tx + 'px';
      tip.style.top = '8px';
      tip.style.transform = 'translateX(-50%)';
    };
    canvas.onmouseleave = () => tip.classList.add('hidden');
  }

  // ============ Commit 列表（按月折叠）============
  function renderMonthList(year: number) {
    const root = $('month-list');
    if (!root) return;

    const filteredCommits = data.commits.filter((c) => {
      const d = new Date(c.date);
      return d.getFullYear() === year;
    });

    // 按月分组
    const byMonth = new Map<string, Commit[]>();
    for (const c of filteredCommits) {
      const d = new Date(c.date);
      const k = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
      if (!byMonth.has(k)) byMonth.set(k, []);
      byMonth.get(k)!.push(c);
    }
    const keys = [...byMonth.keys()].sort((a, b) => b.localeCompare(a));

    const $count = $('commit-total');
    if ($count) $count.textContent = String(filteredCommits.length);

    if (!keys.length) {
      root.innerHTML = '<p class="text-sm text-slate-400 text-center py-8">该年份暂无 commit</p>';
      return;
    }

    const monthNames = ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月'];
    const html = keys.map((k) => {
      const commits = byMonth.get(k)!;
      const [yy, mm] = k.split('-').map(Number);
      const title = `${yy} 年 ${monthNames[mm - 1]}`;
      const isOpen = mm === Math.max(...keys.map((x) => Number(x.split('-')[1]))); // 默认打开最新月
      const rows = commits.map((c) => {
        const d = new Date(c.date);
        const dateStr = `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
        const catTags = c.cats.map((cat) => `<span class="cat-tag ${CAT_CLASS[cat] || 'cat-other'}">${CAT_LABEL[cat] || '?'}</span>`).join('');
        const files = c.files.slice(0, 6).map((f) => `<span class="commit-file" title="${esc(f)}">${esc(f)}</span>`).join('');
        const more = c.files.length > 6 ? `<span class="commit-file">+${c.files.length - 6}</span>` : '';
        return `
          <div class="commit-row">
            <div class="commit-date">${dateStr} · ${relTime(c.date)}</div>
            <div>
              <div>${catTags}<a class="commit-sha" href="${esc(c.url)}" target="_blank" rel="noopener noreferrer">${esc(c.sha)}</a> <span class="commit-subject">${esc(c.subject)}</span></div>
              ${files || more ? `<div class="commit-files">${files}${more}</div>` : ''}
            </div>
            <div class="commit-author text-[10px] font-bold text-slate-400 self-center">${esc(c.author)}</div>
          </div>
        `;
      }).join('');
      return `
        <div class="month-block${isOpen ? ' open' : ''}" data-month="${k}">
          <div class="month-header">
            <svg class="month-chev" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            <span class="month-title">${title}</span>
            <span class="month-meta">${commits.length} 次提交</span>
          </div>
          <div class="month-body"><div class="month-body-inner">${rows}</div></div>
        </div>
      `;
    }).join('');

    root.innerHTML = html;

    root.querySelectorAll<HTMLElement>('.month-block').forEach((blk) => {
      const header = blk.querySelector('.month-header');
      if (!header) return;
      header.addEventListener('click', () => blk.classList.toggle('open'));
    });
  }

  // ============ 年份切换 ============
  function applyYear(year: number) {
    renderHeatmap(year);
    drawMonthChart(year);
    renderMonthList(year);
  }

  function init() {
    if (!data.years.length) return;
    const yearSel = $('year-select') as HTMLSelectElement | null;
    let cur = data.defaultYear;

    renderHeatmap(cur);
    drawPieChart();
    drawWordChart();
    renderMonthList(cur);

    if (yearSel) {
      yearSel.addEventListener('change', () => {
        const y = Number(yearSel.value);
        if (!Number.isNaN(y)) {
          cur = y;
          applyYear(cur);
        }
      });
    }

    const expandBtn = $('expand-all');
    const collapseBtn = $('collapse-all');
    if (expandBtn) expandBtn.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('.month-block').forEach((b) => b.classList.add('open'));
    });
    if (collapseBtn) collapseBtn.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('.month-block').forEach((b) => b.classList.remove('open'));
    });

    // 响应 resize
    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      if (resizeTimer) window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        drawMonthChart(cur);
        drawPieChart();
        drawWordChart();
      }, 120);
    });

    // 视图过渡后重新初始化
    document.addEventListener('astro:page-load', () => init());
  }

  init();
</script>
