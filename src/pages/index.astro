---
import Layout from '../layouts/Layout.astro';
import { getProcessedPosts } from '../utils/postsFetcher';
import HorizontalCategories from '../components/HorizontalCategories.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import PostsTimelineWidget from '../components/PostsTimelineWidget.svelte';
import { i18nConfig } from '../config/site';

const allPosts = await getProcessedPosts();

// Process category counts
const catMap: Record<string, number> = {};
const tagMap: Record<string, number> = {};

allPosts.forEach(post => {
  if (post.category) {
    catMap[post.category] = (catMap[post.category] || 0) + 1;
  }
  if (post.tags) {
    post.tags.forEach(tag => {
      tagMap[tag] = (tagMap[tag] || 0) + 1;
    });
  }
});

const categories = Object.entries(catMap)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);
  
const tags = Object.entries(tagMap)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);

---

<Layout 
  title={i18nConfig.home.title}
  description={i18nConfig.home.description}
  postsCount={allPosts.length}
>
  <HorizontalCategories 
    categories={categories} 
    activeCategory={null} 
    postsDataUrl="/posts-data.json"
  />

  <div class="flex flex-col xl:flex-row gap-4 sm:gap-6 xl:gap-8 items-start justify-center">
    {/* Center Articles Feed - SSR HTML for SEO */}
    <div class="w-full xl:flex-1 min-w-0 flex flex-col gap-4 order-1 xl:order-2">
      {allPosts.slice(0, 10).map(post => (
        <article class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
          <div class="p-4 sm:p-6">
            <div class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-2">
              <time dateTime={post.dateISO}>{post.date}</time>
              {post.category && (
                <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-700 rounded text-xs">
                  <a href={`/category/${encodeURIComponent(post.category)}/`} class="hover:text-blue-600">{post.category}</a>
                </span>
              )}
            </div>
            <h2 class="text-lg sm:text-xl font-bold mb-2">
              <a href={`/posts/${encodeURIComponent(post.slug)}/`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">{post.title}</a>
            </h2>
            {post.description && (
              <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base line-clamp-2 mb-3">{post.description}</p>
            )}
            {post.tags && post.tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {post.tags.map(tag => (
                  <a href={`/tag/${encodeURIComponent(tag)}/`} class="text-xs px-2 py-1 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded hover:bg-blue-100 dark:hover:bg-blue-900/50">#{tag}</a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
      {allPosts.length > 10 && (
        <div class="text-center py-4">
          <a href="/posts/" class="inline-block px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">查看全部 {allPosts.length} 篇文章</a>
        </div>
      )}
    </div>

    {/* Left Sidebar - AFTER content in DOM, visually on left via order-1 */}
    <aside
      id="sidebar-left"
      class="w-full xl:w-[260px] shrink-0 flex flex-col gap-4 sm:gap-6 xl:sticky xl:top-[100px] order-2 xl:order-1"
      style="animation-delay: 0.06s"
    >
      <LeftSidebar posts={[]} postsDataUrl="/posts-data.json" tags={tags} showTags={false} />
    </aside>

    {/* Right Sidebar */}
    <aside
      id="sidebar-right"
      class="w-full xl:w-[260px] shrink-0 flex flex-col gap-4 sm:gap-6 xl:sticky xl:top-[100px] order-3 xl:order-3"
      style="animation-delay: 0.1s"
      transition:name="sidebar-right"
    >
      <PostsTimelineWidget posts={[]} dataUrl="/posts-data.json" client:idle />
    </aside>
  </div>
</Layout>
