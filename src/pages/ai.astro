---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import { AiChatPage } from '../components/AiChatPage';
---

<Layout
  title="UpXuu AI · 文章问答助手"
  description={`基于 ${siteConfig.title} 博客文章的 AI 问答助手，可以回答关于 upxuu 的任何问题`}
>
  <div class="max-w-[1440px] w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-10">
    <div class="max-w-5xl mx-auto">
      {/* AI 标题栏（轻盈风） */}
      <div class="mb-5 flex items-center gap-3 px-1">
        <span class="w-10 h-10 rounded-2xl bg-gradient-to-br from-[#0ea5e9] to-[#6366f1] flex items-center justify-center text-white text-xl font-black shadow-[0_4px_16px_rgba(99,102,241,0.3)]">✦</span>
        <div>
          <h1 class="text-xl sm:text-2xl font-bold text-slate-800 tracking-tight">UpXuu AI</h1>
          <p class="text-xs sm:text-sm text-slate-400">基于博客文章的问答助手 · 后端由 UpXuu AI 提供</p>
        </div>
        <span class="ml-auto text-[10px] font-mono text-slate-300 hidden sm:inline-block">upxuu-ai</span>
      </div>

      {/* AI 聊天（React 组件，直接调 upxuu-ai API） */}
      <AiChatPage client:load />

      <p class="text-center text-[11px] text-slate-300 mt-5">
        AI 回答基于 upxuu 的博客文章，可能不够准确，仅供参考。
      </p>
    </div>
  </div>
</Layout>
