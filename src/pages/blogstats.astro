---
import Layout from '../layouts/Layout.astro';
import { buildSummary } from '../utils/commitStats';

// 首屏只内联聚合摘要（几 KB）；逐提交明细走 /data/commits/N.json 按需拉取
const summary = buildSummary();
const years = [...new Set(summary.daily.map((d) => d.date.slice(0, 4)))].sort().reverse();
const busiest = summary.daily.reduce(
  (best, d) => (d.commits > best.commits ? d : best),
  { date: '—', commits: 0 },
);
---

<Layout
  title="博客统计"
  description="UpXuu 博客建设统计：提交热力图、字数增长、更新内容构成与每次提交明细"
  keywords={['UpXuu', '博客统计', '提交热力图', '字数统计', 'changelog']}
  hideBanner={true}
>
  <div class="w-full max-w-5xl mx-auto pb-20 space-y-4 sm:space-y-5">

    {/* 标题砖 */}
    <div class="brick flex flex-wrap items-center justify-between gap-3" style="--d:0s">
      <div class="flex items-center gap-3">
        <span class="head-icon">🧱</span>
        <div>
          <h1 class="text-xl sm:text-2xl font-black text-[#0284c7] tracking-wide">博客统计</h1>
          <p class="text-[11px] sm:text-xs font-bold text-slate-500 dark:text-slate-400 mt-0.5">
            {summary.repo} · 共 {summary.totals.commits} 次提交
          </p>
        </div>
      </div>
      <a href="/stats" class="chip-link">访问统计 →</a>
    </div>

    {/* 概览数字 */}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      <div class="brick num-brick" data-accent="sky" style="--d:.05s">
        <div class="num-label">提交总数</div>
        <div class="num-value">{summary.totals.commits.toLocaleString('en-US')}</div>
        <div class="num-sub">{summary.totals.activeDays} 天有更新</div>
      </div>
      <div class="brick num-brick" data-accent="amber" style="--d:.1s">
        <div class="num-label">正文总字数</div>
        <div class="num-value">{(summary.totals.words / 1000).toFixed(1)}k</div>
        <div class="num-sub">{summary.totals.posts} 篇文章 · {summary.totals.talks} 条说说</div>
      </div>
      <div class="brick num-brick" data-accent="green" style="--d:.15s">
        <div class="num-label">新增行数</div>
        <div class="num-value">+{(summary.totals.added / 1000).toFixed(1)}k</div>
        <div class="num-sub">删除 {(summary.totals.removed / 1000).toFixed(1)}k 行</div>
      </div>
      <div class="brick num-brick" data-accent="slate" style="--d:.2s">
        <div class="num-label">最勤奋的一天</div>
        <div class="num-value">{busiest.commits}</div>
        <div class="num-sub">{busiest.date} 的提交数</div>
      </div>
    </div>
    {/* 热力图 */}
    <div class="brick heat-brick" style="--d:.25s">
      <div class="brick-head">
        <h2 class="brick-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3M3 11h18M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          提交热力图
        </h2>
        <div class="seg" role="group" aria-label="年份">
          {years.map((y, i) => (
            <button type="button" class={`seg-btn${i === 0 ? ' is-on' : ''}`} data-year={y}>{y}</button>
          ))}
        </div>
      </div>
      <div class="heat-scroll">
        <div class="heat-inner">
          <div id="heat-months" class="heat-months"></div>
          <div id="heatmap" class="heat"></div>
        </div>
      </div>
      <div class="heat-foot">
        <span id="heat-summary" class="heat-note">-</span>
        <span class="heat-legend">
          少
          <i data-lv="0"></i><i data-lv="1"></i><i data-lv="2"></i><i data-lv="3"></i><i data-lv="4"></i>
          多
        </span>
      </div>
      <div id="heat-tip" class="tip" hidden></div>
    </div>

    {/* 字数增长 */}
    <div class="brick" style="--d:.3s">
      <div class="brick-head">
        <h2 class="brick-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          字数增长
        </h2>
        <div class="seg" role="group" aria-label="时间范围">
          <button type="button" class="seg-btn" data-span="30">30 天</button>
          <button type="button" class="seg-btn" data-span="90">90 天</button>
          <button type="button" class="seg-btn" data-span="365">一年</button>
          <button type="button" class="seg-btn is-on" data-span="0">全部</button>
        </div>
      </div>
      <div class="legend">
        <span class="lg-static"><i style="background:#0284c7"></i>累计字数</span>
        <span class="lg-static"><i style="background:#f59e0b"></i>每日新增行</span>
      </div>
      <div class="chart-wrap">
        <canvas id="words-chart" aria-label="字数增长趋势图"></canvas>
        <div id="words-tip" class="tip" hidden></div>
        <div id="words-empty" class="empty" hidden>该区间暂无数据</div>
      </div>
    </div>

    {/* 更新内容构成 */}
    <div class="brick" style="--d:.35s">
      <div class="brick-head">
        <h2 class="brick-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9 9 0 1020.945 13H11V3.055z"/><path stroke-linecap="round" stroke-linejoin="round" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg>
          更新内容构成
        </h2>
        <span class="chip-soft" id="ratio-note">跟随上方时间范围</span>
      </div>
      <div class="ratio-wrap">
        <div class="ratio-donut">
          <canvas id="ratio-chart" aria-label="更新内容构成环形图"></canvas>
          <div class="donut-center">
            <span id="ratio-total">-</span>
            <small>次提交</small>
          </div>
        </div>
        <div id="ratio-list" class="ratio-list"></div>
      </div>
    </div>

    {/* 提交明细 */}
    <div class="brick" style="--d:.4s">
      <div class="brick-head">
        <h2 class="brick-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"/></svg>
          提交明细
        </h2>
        <span class="chip-soft">每页 {summary.perShard} 条 · 按需加载</span>
      </div>
      <div id="commit-list" class="commit-list"><p class="list-msg">加载中…</p></div>
      <div class="pager">
        <button type="button" id="page-prev" class="pg-btn">← 上一页</button>
        <span id="page-info" class="pg-info">- / -</span>
        <button type="button" id="page-next" class="pg-btn">下一页 →</button>
      </div>
    </div>

    <p class="foot-note">
      数据在构建时由 <code>scripts/build-commit-index.mjs</code> 从 Git 历史生成，
      索引随仓库提交，构建产物 {summary.shards} 个明细分片按需拉取。
      最后生成于 {new Date(summary.generatedAt).toLocaleString('zh-CN')}。
    </p>
  </div>

  <script
    is:inline
    type="application/json"
    id="stats-summary"
    set:html={JSON.stringify(summary).replace(/</g, '\\u003c')}
  ></script>
</Layout>

<style>
  /* ---------- 积木砖块基底（与 /stats 保持同一套设计语言） ---------- */
  .brick {
    background: #fff;
    border: 4px solid #0284c7;
    border-radius: 4px;
    box-shadow: 6px 6px 0 0 #0284c7;
    padding: 16px 18px;
    animation: brick-in .55s cubic-bezier(.34, 1.56, .64, 1) both;
    animation-delay: var(--d, 0s);
  }
  :global(.dark) .brick { background: #1e293b; box-shadow: 6px 6px 0 0 #0369a1; }

  @keyframes brick-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .brick { animation: none; }
  }

  /* 热力图砖块要做悬浮标签的定位参照，否则 .tip 会去找更外层的祖先，位置全偏 */
  .heat-brick { position: relative; }

  .head-icon {
    display: grid; place-items: center;
    width: 42px; height: 42px;
    font-size: 20px;
    background: #fde68a;
    border: 3px solid #0284c7;
    border-radius: 4px;
    box-shadow: 3px 3px 0 0 #0284c7;
    flex-shrink: 0;
  }

  .chip-link {
    font-size: 12px; font-weight: 900;
    color: #0284c7; background: #fff;
    border: 3px solid #0284c7; border-radius: 4px;
    box-shadow: 3px 3px 0 0 #f59e0b;
    padding: 5px 10px; text-decoration: none; white-space: nowrap;
    transition: transform .15s, box-shadow .15s;
  }
  .chip-link:hover { transform: translate(1px, 1px); box-shadow: 2px 2px 0 0 #f59e0b; }
  :global(.dark) .chip-link { background: #0f172a; }

  .chip-soft {
    font-size: 11px; font-weight: 800; color: #64748b;
    background: rgba(2, 132, 199, .08);
    border: 2px solid rgba(2, 132, 199, .25);
    border-radius: 4px; padding: 3px 8px; white-space: nowrap;
  }

  .num-brick { padding: 14px 16px; position: relative; overflow: hidden; }
  .num-brick::after {
    content: ''; position: absolute; inset: auto -6px -6px auto;
    width: 46px; height: 46px; background: var(--accent, #0284c7);
    opacity: .12; border-radius: 4px; transform: rotate(18deg);
  }
  .num-brick[data-accent="sky"] { --accent: #0284c7; }
  .num-brick[data-accent="amber"] { --accent: #f59e0b; }
  .num-brick[data-accent="green"] { --accent: #10b981; }
  .num-brick[data-accent="slate"] { --accent: #64748b; }

  .num-label { font-size: 11px; font-weight: 900; color: #64748b; letter-spacing: .04em; }
  .num-value {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-variant-numeric: tabular-nums;
    font-weight: 900; font-size: clamp(1.4rem, 6vw, 2rem);
    line-height: 1.15; color: var(--accent, #0284c7);
    margin-top: 2px; word-break: break-all;
  }
  .num-sub { font-size: 10px; font-weight: 700; color: #94a3b8; margin-top: 2px; }
  :global(.dark) .num-label { color: #94a3b8; }
  :global(.dark) .num-sub { color: #64748b; }
  /* ---------- 砖块标题行 / 分段按钮 ---------- */
  .brick-head {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 10px;
    padding-bottom: 10px; margin-bottom: 12px;
    border-bottom: 2px dashed rgba(2, 132, 199, .25);
  }
  .brick-title {
    display: flex; align-items: center; gap: 7px;
    font-size: 15px; font-weight: 900; color: #0284c7;
  }
  .brick-title svg { width: 18px; height: 18px; flex-shrink: 0; }
  :global(.dark) .brick-head { border-bottom-color: rgba(56, 189, 248, .3); }

  .seg {
    display: inline-flex;
    border: 3px solid #0284c7; border-radius: 4px;
    overflow: hidden; box-shadow: 3px 3px 0 0 #0284c7;
  }
  .seg-btn {
    font-size: 11px; font-weight: 900; color: #0284c7;
    background: #fff; padding: 5px 10px;
    border: 0; border-left: 2px solid rgba(2, 132, 199, .3);
    cursor: pointer; transition: background .15s, color .15s;
  }
  .seg-btn:first-child { border-left: 0; }
  .seg-btn:hover { background: #fde68a; }
  .seg-btn.is-on { background: #0284c7; color: #fff; }
  :global(.dark) .seg-btn { background: #0f172a; }
  :global(.dark) .seg-btn.is-on { background: #0284c7; color: #fff; }

  .legend { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
  .lg-static {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 11px; font-weight: 800; color: #475569;
    background: rgba(2, 132, 199, .06);
    border: 2px solid rgba(2, 132, 199, .22);
    border-radius: 4px; padding: 3px 8px;
  }
  .lg-static i { width: 9px; height: 9px; border-radius: 2px; display: inline-block; }
  :global(.dark) .lg-static { color: #cbd5e1; }

  /* ---------- 热力图 ---------- */
  /* 注意：格子与月份标签是运行时注入的，样式必须放在下面的 is:global 块里，
     写在这个作用域块里会因为缺少 data-astro-cid-* 而完全不生效 */
  .heat-scroll { overflow-x: auto; overflow-y: hidden; padding-bottom: 4px; }
  .heat-inner { min-width: max-content; }

  /* 月份标签与格子列共用同一套列宽，保证标签对得上对应的周 */
  .heat-months {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 13px;
    gap: 3px;
    height: 14px;
    margin-bottom: 3px;
  }

  .heat {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 13px;
    grid-template-rows: repeat(7, 13px);
    gap: 3px;
  }
  .heat-foot {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 8px; margin-top: 10px;
  }
  .heat-note { font-size: 11px; font-weight: 800; color: #64748b; }
  .heat-legend {
    display: inline-flex; align-items: center; gap: 3px;
    font-size: 10px; font-weight: 800; color: #94a3b8;
  }
  .heat-legend i {
    width: 11px; height: 11px; border-radius: 2px; display: inline-block;
    border: 1px solid rgba(2, 132, 199, .18); background: rgba(2, 132, 199, .06);
  }
  .heat-legend i[data-lv="1"] { background: #bae6fd; }
  .heat-legend i[data-lv="2"] { background: #7dd3fc; }
  .heat-legend i[data-lv="3"] { background: #38bdf8; }
  .heat-legend i[data-lv="4"] { background: #0284c7; }
  /* ---------- 图表容器：高度由 CSS 锁定，canvas 只跟随 ---------- */
  .chart-wrap { position: relative; width: 100%; height: 280px; touch-action: pan-y; }
  @media (max-width: 640px) { .chart-wrap { height: 200px; } }
  #words-chart { display: block; width: 100%; height: 100%; }

  .tip {
    position: absolute; z-index: 5; pointer-events: none;
    background: #0f172a; color: #fff;
    border: 2px solid #0284c7; border-radius: 4px;
    box-shadow: 3px 3px 0 0 rgba(2, 132, 199, .5);
    padding: 7px 9px; font-size: 11px; font-weight: 700;
    line-height: 1.5; white-space: nowrap;
  }
  .tip[hidden] { display: none; }
  .empty {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    font-size: 13px; font-weight: 800; color: #94a3b8;
  }
  .empty[hidden] { display: none; }

  /* ---------- 环形占比 ---------- */
  .ratio-wrap {
    display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
  }
  .ratio-donut { position: relative; width: 160px; height: 160px; flex-shrink: 0; }
  #ratio-chart { display: block; width: 100%; height: 100%; }
  .donut-center {
    position: absolute; inset: 0;
    display: grid; place-content: center; text-align: center;
    pointer-events: none;
  }
  .donut-center span {
    display: block;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-variant-numeric: tabular-nums;
    font-size: 22px; font-weight: 900; color: #0284c7;
  }
  .donut-center small { font-size: 10px; font-weight: 800; color: #94a3b8; }

  .ratio-list { flex: 1; min-width: 200px; display: flex; flex-direction: column; gap: 8px; }
  @media (max-width: 480px) {
    .ratio-wrap { gap: 12px; }
    .ratio-donut { width: 128px; height: 128px; margin: 0 auto; }
    .ratio-list { min-width: 100%; }
  }
  /* ---------- 提交明细 / 分页 ---------- */
  .commit-list { display: flex; flex-direction: column; gap: 8px; min-height: 120px; }

  .pager {
    display: flex; align-items: center; justify-content: center;
    gap: 10px; margin-top: 14px;
  }
  .pg-btn {
    font-size: 11px; font-weight: 900; color: #0284c7;
    background: #fff; padding: 6px 12px;
    border: 3px solid #0284c7; border-radius: 4px;
    box-shadow: 3px 3px 0 0 #0284c7;
    cursor: pointer; transition: transform .15s, box-shadow .15s, opacity .15s;
  }
  .pg-btn:hover:not(:disabled) { transform: translate(1px, 1px); box-shadow: 2px 2px 0 0 #0284c7; }
  .pg-btn:disabled {
    opacity: .38; cursor: not-allowed;
    box-shadow: 2px 2px 0 0 #94a3b8; border-color: #94a3b8; color: #94a3b8;
  }
  :global(.dark) .pg-btn { background: #0f172a; }
  .pg-info {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-variant-numeric: tabular-nums;
    font-size: 12px; font-weight: 900; color: #64748b;
  }

  .foot-note {
    font-size: 11px; font-weight: 700; line-height: 1.7;
    color: #94a3b8; text-align: center; padding: 0 8px;
  }
  .foot-note code {
    font-family: var(--font-mono, ui-monospace, monospace);
    background: rgba(2, 132, 199, .1); padding: 1px 5px; border-radius: 3px;
  }

  /* ---------- 窄屏收紧 ---------- */
  @media (max-width: 640px) {
    .brick { padding: 12px 13px; border-width: 3px; box-shadow: 4px 4px 0 0 #0284c7; }
    :global(.dark) .brick { box-shadow: 4px 4px 0 0 #0369a1; }
    .head-icon { width: 36px; height: 36px; font-size: 17px; }
    .num-brick { padding: 11px 12px; }
  }
</style>

<!-- 明细行、占比行、热力图格子都是运行时 innerHTML 注入的，拿不到 Astro 的
     data-astro-cid-* 作用域属性，样式必须写成全局选择器 -->
<style is:global>
  /* ---------- 热力图格子 ---------- */
  #heatmap .heat-cell {
    width: 13px; height: 13px;
    border-radius: 2px;
    border: 1px solid rgba(2, 132, 199, .18);
    background: rgba(2, 132, 199, .06);
    cursor: default;
  }
  /* 有提交的格子可点击跳转 */
  #heatmap .heat-cell[data-lv]:not([data-lv="0"]) { cursor: pointer; }
  #heatmap .heat-cell[data-lv]:not([data-lv="0"]):hover {
    outline: 2px solid #f59e0b;
    outline-offset: 1px;
  }
  #heatmap .heat-cell[data-lv="1"] { background: #bae6fd; border-color: #7dd3fc; }
  #heatmap .heat-cell[data-lv="2"] { background: #7dd3fc; border-color: #38bdf8; }
  #heatmap .heat-cell[data-lv="3"] { background: #38bdf8; border-color: #0ea5e9; }
  #heatmap .heat-cell[data-lv="4"] { background: #0284c7; border-color: #0369a1; }
  #heatmap .heat-cell.is-void { visibility: hidden; }

  #heat-months .heat-mon {
    font-size: 10px;
    font-weight: 900;
    color: #94a3b8;
    white-space: nowrap;
    overflow: visible;
  }

  /* ---------- 提交明细 ---------- */
  #commit-list .cm-row {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 8px 10px;
    background: rgba(2, 132, 199, .04);
    border: 2px solid rgba(2, 132, 199, .18);
    border-radius: 4px;
    transition: background .15s, border-color .15s;
  }
  .dark #commit-list .cm-row { background: rgba(56, 189, 248, .06); border-color: rgba(56, 189, 248, .2); }

  /* 热力图点某天后，那天的提交高亮一下，好在长列表里找到位置 */
  #commit-list .cm-row.is-flash {
    background: #fef3c7;
    border-color: #f59e0b;
  }
  .dark #commit-list .cm-row.is-flash {
    background: rgba(245, 158, 11, .18);
    border-color: #f59e0b;
  }

  #commit-list .cm-kind {
    flex-shrink: 0;
    display: grid; place-items: center;
    width: 26px; height: 26px; font-size: 13px;
    background: #e2e8f0;
    border: 2px solid #0284c7; border-radius: 4px;
  }
  #commit-list .cm-row[data-kind="post"] .cm-kind { background: #bae6fd; }
  #commit-list .cm-row[data-kind="talk"] .cm-kind { background: #bbf7d0; }
  #commit-list .cm-row[data-kind="friend"] .cm-kind { background: #fde68a; }

  #commit-list .cm-body { flex: 1; min-width: 0; }

  /* 整行标题区可点击展开，用 button 保证键盘可达 */
  #commit-list .cm-toggle {
    display: block; width: 100%;
    background: none; border: 0; padding: 0;
    font: inherit; color: inherit; text-align: left;
    cursor: pointer;
  }
  #commit-list .cm-line1 {
    display: flex; align-items: baseline; gap: 8px;
  }
  #commit-list .cm-caret {
    flex-shrink: 0;
    font-size: 9px; font-weight: 900; color: #0284c7;
    transition: transform .18s ease;
    display: inline-block;
  }
  #commit-list .cm-row[aria-expanded="true"] .cm-caret { transform: rotate(90deg); }

  #commit-list .cm-subject {
    flex: 1; min-width: 0;
    font-size: 13px; font-weight: 800; color: #334155;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .dark #commit-list .cm-subject { color: #e2e8f0; }

  #commit-list .cm-sha {
    flex-shrink: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px; font-weight: 900; color: #0284c7;
