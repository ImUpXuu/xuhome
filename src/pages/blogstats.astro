  #commit-list .cm-sha:hover { color: #0ea5e9; }

  #commit-list .cm-meta {
    display: flex; flex-wrap: wrap; gap: 8px;
    margin-top: 3px;
    font-size: 10px; font-weight: 800; color: #94a3b8;
  }
  #commit-list .cm-add { color: #10b981; }
  #commit-list .cm-del { color: #ef4444; }

  /* 折叠区：默认收起，只有 aria-expanded="true" 时展开 */
  #commit-list .cm-detail { display: none; }
  #commit-list .cm-row[aria-expanded="true"] .cm-detail { display: block; }

  #commit-list .cm-files {
    margin-top: 6px; padding-top: 6px;
    border-top: 1px dashed rgba(2, 132, 199, .22);
