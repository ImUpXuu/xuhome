  #commit-list .cm-fpath {
    flex: 1; min-width: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .dark #commit-list .cm-file { color: #94a3b8; }
  #commit-list .cm-more { font-size: 10px; font-weight: 800; color: #94a3b8; }

  #commit-list .cm-actions {
    margin-top: 6px;
    display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
  }
  #commit-list .cm-link {
    font-size: 10px; font-weight: 900; color: #0284c7;
    text-decoration: none;
    border: 2px solid rgba(2, 132, 199, .3);
    border-radius: 3px; padding: 2px 7px;
  }
  #commit-list .cm-link:hover { background: #fde68a; }

  #commit-list .list-msg,
  #ratio-list .list-msg {
    text-align: center; padding: 22px 0;
    font-size: 13px; font-weight: 800; color: #94a3b8;
  }

  #ratio-list .rt-row { display: flex; align-items: center; gap: 9px; }
  #ratio-list .rt-dot {
    width: 11px; height: 11px; border-radius: 3px;
    flex-shrink: 0; border: 2px solid rgba(0, 0, 0, .12);
  }
  #ratio-list .rt-body { flex: 1; min-width: 0; }
  #ratio-list .rt-line { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
  #ratio-list .rt-name { font-size: 12px; font-weight: 900; color: #334155; }
  .dark #ratio-list .rt-name { color: #e2e8f0; }
  #ratio-list .rt-num {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-variant-numeric: tabular-nums;
    font-size: 11px; font-weight: 900; color: #0284c7;
  }
  #ratio-list .rt-bar {
    margin-top: 3px; height: 7px;
    background: rgba(2, 132, 199, .1);
    border: 2px solid rgba(2, 132, 199, .22);
    border-radius: 3px; overflow: hidden;
  }
  #ratio-list .rt-fill { height: 100%; transition: width .5s cubic-bezier(.22, 1, .36, 1); }
</style>

<script>
  /* ================= 常量与工具 ================= */
  const KIND_META = {
    post: { name: '文章', color: '#0284c7', icon: '📝' },
    talk: { name: '说说', color: '#10b981', icon: '💬' },
    friend: { name: '友链', color: '#f59e0b', icon: '🔗' },
    other: { name: '其他', color: '#94a3b8', icon: '⚙️' },
  };
  const KIND_ORDER = ['post', 'talk', 'friend', 'other'];
  const DAY = 86400000;

  const $ = (id) => document.getElementById(id);

  function esc(s) {
    return String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  }

  function nfmt(n) {
    const v = Number(n) || 0;
    if (v >= 100000) return (v / 10000).toFixed(1) + '万';
    return v.toLocaleString('en-US');
  }

  /** 坐标轴专用：同一条轴上不能一半"万"一半千分位，统一用 k/万 短标 */
  function axisFmt(n) {
    const v = Number(n) || 0;
    if (v >= 10000) return (v / 10000).toFixed(v % 10000 === 0 ? 0 : 1) + '万';
    if (v >= 1000) return (v / 1000).toFixed(v % 1000 === 0 ? 0 : 1) + 'k';
    return String(v);
  }

  function p2(v) { return String(v).padStart(2, '0'); }

  function ymd(d) {
    return `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())}`;
  }

  /** 取当天 00:00 的本地时间戳，避免把提交算到隔天 */
  function dayStart(ts) {
    const d = new Date(ts);
    d.setHours(0, 0, 0, 0);
    return d.getTime();
  }

  function readSummary() {
    const el = $('stats-summary');
    if (!el) return null;
    try {
      return JSON.parse(el.textContent || '{}');
    } catch {
      return null;
    }
  }
  /* ================= 热力图 ================= */
  // GitHub 风格：一列一周，周日在最上。按年渲染，格子数固定，
  // 所以不会出现容器被内容反向撑高的问题。
  function renderHeatmap(state, year) {
    const box = $('heatmap');
    if (!box) return;

    const byDate = new Map(state.summary.daily.map((d) => [d.date, d]));
    const first = new Date(Number(year), 0, 1);
    const last = new Date(Number(year), 11, 31);
    const today = dayStart(Date.now());

    // 从当年 1/1 所在周的周日开始铺，保证每列都是完整一周
    const start = new Date(first);
    start.setDate(start.getDate() - start.getDay());

    let max = 0;
    for (const d of state.summary.daily) {
      if (d.date.slice(0, 4) === String(year)) max = Math.max(max, d.commits);
    }

    const cells = [];
    const monthLabels = [];
    let total = 0;
    let activeDays = 0;
    let lastMonth = -1;

    for (let t = start.getTime(); t <= last.getTime(); t += DAY) {
      const d = new Date(t);
      const key = ymd(d);
      const inYear = d.getFullYear() === Number(year);
      const future = t > today;

      // 每列开头（周日）判断是否进入新月份，给月份标签占位
      if (d.getDay() === 0) {
        if (d.getMonth() !== lastMonth && inYear) {
          lastMonth = d.getMonth();
          monthLabels.push(`<span class="heat-mon">${d.getMonth() + 1}月</span>`);
        } else {
          monthLabels.push('<span class="heat-mon"></span>');
        }
      }

      if (!inYear || future) {
        cells.push('<div class="heat-cell is-void"></div>');
        continue;
      }

      const rec = byDate.get(key);
      const n = rec ? rec.commits : 0;
      if (n > 0) { total += n; activeDays++; }

      // 4 档：按当年峰值分段，避免个别爆发日把其余全压成最浅色
      let lv = 0;
      if (n > 0) {
        const ratio = max > 0 ? n / max : 0;
        lv = ratio > 0.6 ? 4 : ratio > 0.35 ? 3 : ratio > 0.15 ? 2 : 1;
      }

      const parts = [];
      if (rec) {
        for (const k of KIND_ORDER) {
          if (rec.kinds[k]) parts.push(`${KIND_META[k].name}${rec.kinds[k]}`);
        }
      }
      const title = n ? `${key} · ${n} 次提交${parts.length ? ' · ' + parts.join(' ') : ''}${n ? ' · 点击查看' : ''}` : `${key} · 无提交`;
      cells.push(`<div class="heat-cell" data-lv="${lv}" data-date="${key}" data-tip="${esc(title)}"></div>`);
    }

    box.innerHTML = cells.join('');
    const months = $('heat-months');
    if (months) months.innerHTML = monthLabels.join('');
    $('heat-summary').textContent =
      `${year} 年共 ${total} 次提交，${activeDays} 天有更新${max ? `，单日最多 ${max} 次` : ''}`;

    // 窄屏放不下一整年，默认滚到最近有提交的位置，否则一打开只看到年初的空白
    const scroller = box.closest('.heat-scroll');
    if (scroller) {
      // 注意不能用 :last-of-type —— 它按标签名判断，这里全是 div 会失配
      const active = box.querySelectorAll('.heat-cell[data-lv]:not([data-lv="0"])');
      const lastActive = active.length ? active[active.length - 1] : null;
      if (lastActive) {
        const target = lastActive.offsetLeft - scroller.clientWidth + lastActive.offsetWidth + 20;
        scroller.scrollLeft = Math.max(0, target);
      } else {
        scroller.scrollLeft = scroller.scrollWidth;
      }
    }
  }

  function bindHeatTip(state, signal, onPickDay) {
    const box = $('heatmap');
    const tip = $('heat-tip');
    if (!box || !tip) return;

    const show = (cell) => {
      const text = cell.dataset.tip;
      if (!text) return;
      tip.textContent = text;
      tip.hidden = false;

      // 相对定位参照是 .heat-brick。注意绝对定位的 left/top 是相对它的
      // padding box，而 getBoundingClientRect() 给的是 border box，
      // 差一圈边框宽度（clientLeft/clientTop），不减掉标签会整体偏移。
      const card = cell.closest('.heat-brick');
      if (!card) return;
      const cr = card.getBoundingClientRect();
      const originX = cr.left + card.clientLeft;
      const originY = cr.top + card.clientTop;

      // 用 rect 相减而不是 offsetLeft：格子在横向滚动容器里，
      // offsetLeft 相对未滚动的内容起点，滚动后会整体偏出去
      const br = cell.getBoundingClientRect();

      const maxLeft = Math.max(4, card.clientWidth - tip.offsetWidth - 4);
      let left = br.left - originX + br.width / 2 - tip.offsetWidth / 2;
      left = Math.min(Math.max(left, 4), maxLeft);

      // 上方空间不够时翻到格子下方
      let top = br.top - originY - tip.offsetHeight - 6;
      if (top < 2) top = br.bottom - originY + 6;

      tip.style.left = left + 'px';
      tip.style.top = top + 'px';
    };

    box.addEventListener('mouseover', (e) => {
      const cell = e.target.closest('.heat-cell');
      if (cell) show(cell);
    }, { signal });
    box.addEventListener('mouseleave', () => { tip.hidden = true; }, { signal });

    // 点格子：先弹提示（手机端只有点击能看），有提交的话再跳到当天的明细
    box.addEventListener('click', (e) => {
      const cell = e.target.closest('.heat-cell');
      if (!cell) { tip.hidden = true; return; }
      show(cell);
      const date = cell.dataset.date;
      if (date && cell.dataset.lv !== '0' && onPickDay) onPickDay(date);
    }, { signal });

    // 横向滚动后标签会脱离原格子，直接收起
    const scroller = box.closest('.heat-scroll');
    if (scroller) {
      scroller.addEventListener('scroll', () => { tip.hidden = true; }, { signal, passive: true });
    }
  }
  /* ================= 字数增长图 ================= */
  let wordsGeo = { padL: 44, padR: 14, padT: 12, padB: 24, n: 0 };
  let wordsSeries = [];
  let wordsHover = -1;

  function niceMax(raw) {
    if (raw <= 5) return 5;
    const mag = Math.pow(10, Math.floor(Math.log10(raw)));
    const norm = raw / mag;
    const step = norm <= 1 ? 1 : norm <= 2 ? 2 : norm <= 5 ? 5 : 10;
    return step * mag;
  }

  function smoothPath(ctx, pts) {
    if (!pts.length) return;
    ctx.moveTo(pts[0].x, pts[0].y);
    if (pts.length < 3) {
      for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i].x, pts[i].y);
      return;
    }
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[Math.max(0, i - 1)];
      const p1 = pts[i];
      const p2 = pts[i + 1];
      const p3 = pts[Math.min(pts.length - 1, i + 2)];
      ctx.bezierCurveTo(
        p1.x + (p2.x - p0.x) / 6, p1.y + (p2.y - p0.y) / 6,
        p2.x - (p3.x - p1.x) / 6, p2.y - (p3.y - p1.y) / 6,
        p2.x, p2.y,
      );
    }
  }

  /**
   * 把「每篇内容的首次提交时间 + 当前字数」变成逐日累计曲线。
   * spanDays=0 表示全部；否则只画最近 N 天，但起点累计值要包含更早的存量，
   * 否则曲线会从 0 开始，看起来像字数被清零了。
   */
  function buildWordsSeries(summary, spanDays) {
    const pts = summary.wordPoints || [];
    const daily = summary.daily || [];
    if (!pts.length && !daily.length) return [];

    const lastTs = Math.max(
      pts.length ? pts[pts.length - 1].ts : 0,
      daily.length ? new Date(daily[daily.length - 1].date + 'T00:00:00').getTime() : 0,
      Date.now(),
    );
    const endDay = dayStart(lastTs);
    const firstTs = Math.min(
      pts.length ? pts[0].ts : Infinity,
      daily.length ? new Date(daily[0].date + 'T00:00:00').getTime() : Infinity,
    );
    const startDay = spanDays > 0
      ? Math.max(dayStart(firstTs), endDay - (spanDays - 1) * DAY)
      : dayStart(firstTs);

    // 区间起点之前的存量字数
    let base = 0;
    for (const p of pts) {
      if (dayStart(p.ts) < startDay) base += p.words;
    }

    const addByDay = new Map();
    for (const p of pts) {
      const k = dayStart(p.ts);
      if (k < startDay) continue;
      addByDay.set(k, (addByDay.get(k) || 0) + p.words);
    }
    const lineByDay = new Map();
    for (const d of daily) {
      const k = dayStart(new Date(d.date + 'T00:00:00').getTime());
      if (k < startDay) continue;
      lineByDay.set(k, d.added);
    }

    // 逐日铺满，天数上限 400 点：更长区间按周采样，避免几千个点挤在一起
    const totalDays = Math.round((endDay - startDay) / DAY) + 1;
    const stride = totalDays > 400 ? Math.ceil(totalDays / 400) : 1;

    const series = [];
    let cum = base;
    let bucketAdded = 0;
    let bucketLines = 0;
    for (let i = 0; i < totalDays; i++) {
      const k = startDay + i * DAY;
      cum += addByDay.get(k) || 0;
      bucketAdded += addByDay.get(k) || 0;
      bucketLines += lineByDay.get(k) || 0;
      if (i % stride === stride - 1 || i === totalDays - 1) {
        series.push({ ts: k, words: cum, added: bucketAdded, lines: bucketLines });
        bucketAdded = 0;
        bucketLines = 0;
      }
    }
    return series;
  }
  function drawWords() {
    const canvas = $('words-chart');
    if (!canvas) return;

    // 尺寸由 CSS 锁定（.chart-wrap 固定高度），canvas 只读 client 尺寸跟随，
    // 不写 height 属性，避免内在比例变化把容器越撑越高
    const cssW = canvas.clientWidth;
    const cssH = canvas.clientHeight;
    if (!cssW || !cssH) return;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const bw = Math.round(cssW * dpr);
    const bh = Math.round(cssH * dpr);
    if (canvas.width !== bw) canvas.width = bw;
    if (canvas.height !== bh) canvas.height = bh;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, cssW, cssH);

    const n = wordsSeries.length;
    const emptyEl = $('words-empty');
    if (emptyEl) emptyEl.hidden = n > 0;
    if (!n) return;

    const narrow = cssW < 480;
    const padL = narrow ? 34 : 46;
    const padR = narrow ? 30 : 42;
    const padT = 12;
    const padB = 24;
    const plotW = cssW - padL - padR;
    const plotH = cssH - padT - padB;
    wordsGeo = { padL, padR, padT, padB, n };
    if (plotW <= 0 || plotH <= 0) return;

    const maxWords = niceMax(Math.max(...wordsSeries.map((s) => s.words), 1));
    const maxLines = niceMax(Math.max(...wordsSeries.map((s) => s.lines), 1));

    const xAt = (i) => padL + (n === 1 ? plotW / 2 : (i / (n - 1)) * plotW);
    const yWords = (v) => padT + plotH - (v / maxWords) * plotH;
    const yLines = (v) => padT + plotH - (v / maxLines) * plotH;

    const dark = document.documentElement.classList.contains('dark');
    const grid = dark ? 'rgba(148,163,184,.18)' : 'rgba(2,132,199,.14)';
    const steps = narrow ? 3 : 5;

    ctx.lineWidth = 1;
    ctx.font = '900 10px ui-monospace, monospace';
    ctx.textBaseline = 'middle';
    for (let g = 0; g <= steps; g++) {
      const gy = Math.round(padT + (g / steps) * plotH) + 0.5;
      ctx.strokeStyle = grid;
      ctx.beginPath();
      ctx.moveTo(padL, gy);
      ctx.lineTo(cssW - padR, gy);
      ctx.stroke();
      const frac = (steps - g) / steps;
      ctx.fillStyle = '#94a3b8';
      ctx.textAlign = 'right';
      ctx.fillText(axisFmt(Math.round(maxWords * frac)), padL - 6, gy);
      ctx.fillStyle = '#d97706';
      ctx.textAlign = 'left';
      ctx.fillText(axisFmt(Math.round(maxLines * frac)), cssW - padR + 6, gy);
    }

    // X 轴日期
    ctx.fillStyle = '#94a3b8';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'alphabetic';
    const ticks = narrow ? 3 : 6;
    const step = Math.max(1, Math.ceil(n / ticks));
    for (let i = 0; i < n; i += step) {
      const d = new Date(wordsSeries[i].ts);
      ctx.fillText(`${p2(d.getMonth() + 1)}/${p2(d.getDate())}`, xAt(i), cssH - 7);
    }

    // 每日新增行：柱状（右轴）
    const barW = Math.max(1, Math.min(10, plotW / n - 1));
    ctx.fillStyle = 'rgba(245,158,11,.55)';
    for (let i = 0; i < n; i++) {
      const v = wordsSeries[i].lines;
      if (!v) continue;
      const y = yLines(v);
      ctx.fillRect(xAt(i) - barW / 2, y, barW, padT + plotH - y);
    }

    if (wordsHover >= 0 && wordsHover < n) {
      ctx.strokeStyle = 'rgba(2,132,199,.45)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([4, 3]);
      ctx.beginPath();
      ctx.moveTo(xAt(wordsHover), padT);
      ctx.lineTo(xAt(wordsHover), padT + plotH);
      ctx.stroke();
      ctx.setLineDash([]);
    }

    // 累计字数：面积 + 平滑曲线（左轴）
    const pts = wordsSeries.map((s, i) => ({ x: xAt(i), y: yWords(s.words) }));
    const grad = ctx.createLinearGradient(0, padT, 0, padT + plotH);
    grad.addColorStop(0, 'rgba(2,132,199,.34)');
    grad.addColorStop(1, 'rgba(2,132,199,0)');
    ctx.beginPath();
    smoothPath(ctx, pts);
    ctx.lineTo(pts[pts.length - 1].x, padT + plotH);
    ctx.lineTo(pts[0].x, padT + plotH);
    ctx.closePath();
    ctx.fillStyle = grad;
    ctx.fill();

    ctx.strokeStyle = '#0284c7';
    ctx.lineWidth = 2.5;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.beginPath();
    smoothPath(ctx, pts);
    ctx.stroke();

    if (wordsHover >= 0 && wordsHover < n) {
      const p = pts[wordsHover];
      ctx.beginPath();
      ctx.arc(p.x, p.y, 4.5, 0, Math.PI * 2);
      ctx.fillStyle = '#0284c7';
      ctx.fill();
      ctx.strokeStyle = dark ? '#1e293b' : '#fff';
      ctx.lineWidth = 2;
      ctx.stroke();
    }
  }

  function showWordsTip(clientX) {
    const canvas = $('words-chart');
    const tip = $('words-tip');
    if (!canvas || !tip || !wordsSeries.length) return;

    const rect = canvas.getBoundingClientRect();
    const plotW = rect.width - wordsGeo.padL - wordsGeo.padR;
    if (plotW <= 0) return;
    const raw = Math.round(((clientX - rect.left - wordsGeo.padL) / plotW) * (wordsGeo.n - 1));
    const idx = Math.min(Math.max(raw, 0), wordsGeo.n - 1);
    wordsHover = idx;
    drawWords();

    const s = wordsSeries[idx];
    const d = new Date(s.ts);
    tip.innerHTML =
      `<div style="font-weight:900;margin-bottom:3px">${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())}</div>` +
      `<div><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#0284c7;margin-right:5px"></span>累计 ${nfmt(s.words)} 字</div>` +
      (s.added ? `<div style="color:#7dd3fc">本区间新增 ${nfmt(s.added)} 字</div>` : '') +
      `<div><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#f59e0b;margin-right:5px"></span>改动 ${nfmt(s.lines)} 行</div>`;
    tip.hidden = false;

    const px = wordsGeo.padL + (wordsGeo.n === 1 ? plotW / 2 : (idx / (wordsGeo.n - 1)) * plotW);
    let left = px + 12;
    if (left + tip.offsetWidth > rect.width - 2) left = px - tip.offsetWidth - 12;
    tip.style.left = Math.max(2, left) + 'px';
    tip.style.top = '8px';
  }

  function hideWordsTip() {
    const tip = $('words-tip');
    if (tip) tip.hidden = true;
    wordsHover = -1;
    drawWords();
  }
  /* ================= 更新内容构成（环形图） ================= */
  function drawRatio(counts) {
    const canvas = $('ratio-chart');
    if (!canvas) return;
    const cssW = canvas.clientWidth;
    const cssH = canvas.clientHeight;
    if (!cssW || !cssH) return;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    if (canvas.width !== Math.round(cssW * dpr)) canvas.width = Math.round(cssW * dpr);
    if (canvas.height !== Math.round(cssH * dpr)) canvas.height = Math.round(cssH * dpr);

    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, cssW, cssH);

    const total = KIND_ORDER.reduce((s, k) => s + (counts[k] || 0), 0);
    const cx = cssW / 2;
    const cy = cssH / 2;
    const r = Math.min(cx, cy) - 6;
    const thick = Math.max(14, r * 0.42);

    // 底环
    ctx.beginPath();
    ctx.arc(cx, cy, r - thick / 2, 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(2,132,199,.12)';
    ctx.lineWidth = thick;
    ctx.stroke();

    if (!total) return;

    let angle = -Math.PI / 2;
    for (const k of KIND_ORDER) {
      const v = counts[k] || 0;
      if (!v) continue;
      const sweep = (v / total) * Math.PI * 2;
      ctx.beginPath();
      ctx.arc(cx, cy, r - thick / 2, angle, angle + sweep);
      ctx.strokeStyle = KIND_META[k].color;
      ctx.lineWidth = thick;
      ctx.lineCap = 'butt';
      ctx.stroke();
      angle += sweep;
    }
  }

  function renderRatio(counts) {
    const total = KIND_ORDER.reduce((s, k) => s + (counts[k] || 0), 0);
    $('ratio-total').textContent = nfmt(total);
    drawRatio(counts);

    const list = $('ratio-list');
    if (!list) return;
    if (!total) {
      list.innerHTML = '<p class="list-msg">该区间没有提交</p>';
      return;
    }
    list.innerHTML = KIND_ORDER.map((k) => {
      const v = counts[k] || 0;
      const pct = total ? (v / total) * 100 : 0;
      const m = KIND_META[k];
      return `<div class="rt-row">
  <span class="rt-dot" style="background:${m.color}"></span>
  <div class="rt-body">
    <div class="rt-line">
      <span class="rt-name">${m.icon} ${m.name}</span>
      <span class="rt-num">${v} 次 · ${pct.toFixed(1)}%</span>
    </div>
    <div class="rt-bar"><div class="rt-fill" style="width:${Math.max(pct, v ? 1.5 : 0)}%;background:${m.color}"></div></div>
  </div>
</div>`;
    }).join('');
  }

  /** 按当前时间范围统计各类提交数 */
  function countKinds(summary, spanDays) {
    const counts = { post: 0, talk: 0, friend: 0, other: 0 };
    const daily = summary.daily || [];
    if (!daily.length) return counts;

    let cutoff = 0;
    if (spanDays > 0) {
      const lastDay = dayStart(new Date(daily[daily.length - 1].date + 'T00:00:00').getTime());
      cutoff = Math.max(lastDay, dayStart(Date.now())) - (spanDays - 1) * DAY;
    }
    for (const d of daily) {
      const t = dayStart(new Date(d.date + 'T00:00:00').getTime());
      if (t < cutoff) continue;
      for (const k of KIND_ORDER) counts[k] += d.kinds[k] || 0;
    }
    return counts;
  }
  /* ================= 提交明细（按需分页） ================= */
  const shardCache = new Map();
  let curPage = 1;
  let pageSeq = 0;

  async function loadShard(page) {
    if (shardCache.has(page)) return shardCache.get(page);
    const r = await fetch(`/data/commits/${page}.json`, {
      headers: { Accept: 'application/json' },
      signal: AbortSignal.timeout(12000),
    });
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const j = await r.json();
    shardCache.set(page, j);
    return j;
  }

  function ymdOf(ts) {
    const d = new Date(ts);
    return `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())}`;
  }

  function commitRow(c, repo) {
    const m = KIND_META[c.kind] || KIND_META.other;
    const d = new Date(c.ts);
    const when = `${ymdOf(c.ts)} ${p2(d.getHours())}:${p2(d.getMinutes())}`;

    // 展开区列出全部改动文件；40 个以上截断，避免个别大提交把 DOM 撑爆
    const cap = 40;
    const shown = c.files.slice(0, cap);
    const rest = c.files.length - shown.length;
    const files = shown.map(([path, add, del]) =>
      `<div class="cm-file"><span class="cm-fpath" title="${esc(path)}">${esc(path)}</span>` +
      `<span class="cm-add">+${add}</span><span class="cm-del">-${del}</span></div>`
    ).join('') + (rest > 0 ? `<div class="cm-more">…还有 ${rest} 个文件</div>` : '');

    return `<div class="cm-row" data-kind="${c.kind}" data-date="${ymdOf(c.ts)}" data-sha="${esc(c.sha)}" aria-expanded="false">
  <span class="cm-kind" title="${m.name}">${m.icon}</span>
  <div class="cm-body">
    <button type="button" class="cm-toggle">
      <div class="cm-line1">
        <span class="cm-caret">▶</span>
        <span class="cm-subject" title="${esc(c.subject)}">${esc(c.subject)}</span>
      </div>
      <div class="cm-meta">
        <span>${when}</span>
        <span>${esc(c.author)}</span>
        <span class="cm-add">+${c.added}</span>
        <span class="cm-del">-${c.removed}</span>
        <span>${c.fileCount} 个文件</span>
      </div>
    </button>
    <div class="cm-detail">
      ${c.files.length ? `<div class="cm-files">${files}</div>` : '<div class="cm-more">这次提交没有可统计的文件改动</div>'}
      <div class="cm-actions">
        <a class="cm-link" href="https://github.com/${repo}/commit/${esc(c.sha)}" target="_blank" rel="noopener">在 GitHub 查看 ${esc(c.sha.slice(0, 7))} →</a>
      </div>
    </div>
  </div>
</div>`;
  }

  /**
   * 渲染某一页明细。focusDate 来自热力图点击：渲染完后滚到那天第一条并高亮。
   */
  async function renderPage(state, page, focusDate) {
    const list = $('commit-list');
    if (!list) return;
    const seq = ++pageSeq;
    list.innerHTML = '<p class="list-msg">加载中…</p>';

    let data;
    try {
      data = await loadShard(page);
    } catch (e) {
      if (seq !== pageSeq) return;
      list.innerHTML = '<p class="list-msg">明细加载失败，请稍后重试</p>';
      return;
    }
    if (seq !== pageSeq) return; // 快速连点时丢弃过期响应

    curPage = page;
    const repo = state.summary.repo || '';
    list.innerHTML = data.commits.length
      ? data.commits.map((c) => commitRow(c, repo)).join('')
      : '<p class="list-msg">没有提交记录</p>';

    const total = data.total || state.summary.shards || 1;
    $('page-info').textContent = `${page} / ${total}`;
    $('page-prev').disabled = page <= 1;
    $('page-next').disabled = page >= total;

    if (focusDate) focusOnDate(list, focusDate);

    // 预取下一页，翻页时几乎无等待
    if (page < total && !shardCache.has(page + 1)) {
      loadShard(page + 1).catch(() => {});
    }
  }

  /** 高亮并滚动到某天的第一条提交 */
  function focusOnDate(list, date) {
    const rows = list.querySelectorAll(`.cm-row[data-date="${date}"]`);
    if (!rows.length) return;
    for (const r of rows) r.classList.add('is-flash');
    rows[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
    // 高亮只是定位提示，两秒后褪掉，别一直亮着
    setTimeout(() => {
      for (const r of rows) r.classList.remove('is-flash');
    }, 2200);
  }
  /* ================= 初始化 / 清理 ================= */
  // 监听器与观察器统一挂在 AbortController 上，view transition 换页时一次性注销
  let ac = null;
  let ro = null;

  function teardown() {
    if (ac) { ac.abort(); ac = null; }
    if (ro) { ro.disconnect(); ro = null; }
  }

  function setup() {
    const root = $('heatmap');
    teardown();
    if (!root) return;

    const summary = readSummary();
    if (!summary) return;
    const state = { summary };

    shardCache.clear();
    wordsSeries = [];
    wordsHover = -1;
    curPage = 1;

    ac = new AbortController();
    const signal = ac.signal;

    // 点热力图某天 → 翻到那天所在的明细页并高亮
    const jumpToDay = (date) => {
      const page = (summary.dayShards || {})[date];
      if (!page) return;
      const list = $('commit-list');
      if (page === curPage && list) {
        focusOnDate(list, date);
        list.closest('.brick').scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
      renderPage(state, page, date);
      if (list) list.closest('.brick').scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    // 热力图：默认最近一年
    const years = [...document.querySelectorAll('[data-year]')];
    const initialYear = years.length ? years[0].dataset.year : String(new Date().getFullYear());
    renderHeatmap(state, initialYear);
    bindHeatTip(state, signal, jumpToDay);
    for (const btn of years) {
      btn.addEventListener('click', () => {
        years.forEach((b) => b.classList.toggle('is-on', b === btn));
        $('heat-tip').hidden = true;
        renderHeatmap(state, btn.dataset.year);
      }, { signal });
    }

    // 字数图 + 占比图共用同一时间范围
    let span = 0;
    const applySpan = () => {
      wordsSeries = buildWordsSeries(summary, span);
      wordsHover = -1;
      drawWords();
      renderRatio(countKinds(summary, span));
      const label = span === 0 ? '全部时间' : `最近 ${span} 天`;
      $('ratio-note').textContent = label;
    };
    applySpan();

    for (const btn of document.querySelectorAll('[data-span]')) {
      btn.addEventListener('click', () => {
        const v = Number(btn.dataset.span);
        if (v === span) return;
        span = v;
        document.querySelectorAll('[data-span]').forEach((b) => b.classList.toggle('is-on', b === btn));
        hideWordsTip();
        applySpan();
      }, { signal });
    }

    const canvas = $('words-chart');
    canvas.addEventListener('mousemove', (e) => showWordsTip(e.clientX), { signal });
    canvas.addEventListener('mouseleave', hideWordsTip, { signal });
    canvas.addEventListener('touchstart', (e) => { if (e.touches[0]) showWordsTip(e.touches[0].clientX); }, { signal, passive: true });
    canvas.addEventListener('touchmove', (e) => { if (e.touches[0]) showWordsTip(e.touches[0].clientX); }, { signal, passive: true });
    canvas.addEventListener('touchend', hideWordsTip, { signal });

    // 明细分页
    $('page-prev').addEventListener('click', () => {
      if (curPage > 1) renderPage(state, curPage - 1);
    }, { signal });
    $('page-next').addEventListener('click', () => {
      renderPage(state, curPage + 1);
    }, { signal });

    // 折叠展开：事件委托到列表，避免每次渲染重新绑 100 个监听器
    $('commit-list').addEventListener('click', (e) => {
      const btn = e.target.closest('.cm-toggle');
      if (!btn) return;
      const row = btn.closest('.cm-row');
      if (!row) return;
      row.setAttribute('aria-expanded', row.getAttribute('aria-expanded') === 'true' ? 'false' : 'true');
    }, { signal });

    renderPage(state, 1);

    // 容器高度由 CSS 固定，这里只重算位图密度与坐标
    if ('ResizeObserver' in window) {
      ro = new ResizeObserver(() => {
        drawWords();
        renderRatio(countKinds(summary, span));
      });
      ro.observe(canvas.parentElement);
    } else {
      window.addEventListener('resize', () => drawWords(), { signal });
    }
  }

  setup();
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', teardown);






</script>
