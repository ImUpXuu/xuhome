---
import { render } from 'astro:content';
import { getCollection } from 'astro:content';
import { getProcessedPosts } from '../../utils/postsFetcher';
import { siteConfig, seoConfig } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getProcessedPosts();
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const canonicalURL = `${siteConfig.url}/posts/${encodeURIComponent(post.slug)}/`;
const pageImage = post.img || seoConfig.defaultImage;
const pageTitle = post.title
  ? `${post.title}${seoConfig.titleTemplate}`
  : `${siteConfig.title} - ${siteConfig.subtitle.split(' / ')[0]}`;
const pageDescription = post.description || '';
const pageKeywords = post.keywords?.length ? post.keywords : seoConfig.keywords;

const rawPosts = await getCollection('posts');
const articleEntry = rawPosts.find(p =>
  p.id === post.id || (p.slug || p.id) === post.slug
);
const { Content } = articleEntry ? await render(articleEntry) : { Content: () => null };
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="bingbot" content="index, follow" />
    <meta name="baiduspider" content="index, follow" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="author" content={siteConfig.author} />
    <meta name="keywords" content={pageKeywords.join(", ")} />
    <meta name="msvalidate.01" content="8814B55DAA53801F47B998FE06421544" />
    <link rel="icon" href={siteConfig.avatar} />
    <link rel="apple-touch-icon" href={siteConfig.avatar} />

    
    <meta name="geo.region" content="CN-HE" />
    <meta name="geo.placename" content="Shijiazhuang" />
    <meta name="geo.position" content="38.0428;114.5149" />
    <meta name="ICBM" content="38.0428, 114.5149" />

    
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:locale:alternate" content="zh_CN" />
    {post.dateISO && <meta property="article:published_time" content={post.dateISO} />}
    <meta property="og:image" content={pageImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ImUpXuu" />
    <meta name="twitter:creator" content="@ImUpXuu" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={pageImage} />

    
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": pageTitle,
      "description": pageDescription,
      "image": pageImage,
      "datePublished": post.dateISO || post.date,
      "author": {
        "@type": "Person",
        "name": siteConfig.author,
        "url": siteConfig.url
      },
      "publisher": {
        "@type": "Person",
        "name": siteConfig.author,
        "image": siteConfig.avatar
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalURL
      }
    })} />
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; line-height: 1.8; color: #333; }
      h1 { color: #1a1a2e; border-bottom: 2px solid #0284c7; padding-bottom: 10px; }
      h2 { color: #16213e; margin-top: 30px; border-bottom: 1px solid #eee; padding-bottom: 5px; }
      h3 { color: #0f3460; }
      a { color: #0284c7; text-decoration: underline; }
      a:hover { color: #0369a1; }
      blockquote { border-left: 4px solid #0284c7; padding: 10px 20px; margin: 20px 0; background: #f8fafc; font-style: italic; }
      code { background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }
      pre { background: #1e293b; color: #e2e8f0; padding: 15px; border-radius: 8px; overflow-x: auto; }
      pre code { background: none; color: inherit; }
      img { max-width: 100%; height: auto; border-radius: 8px; }
      strong { color: #1a1a2e; }
      em { color: #555; }
      ul, ol { padding-left: 25px; }
      li { margin-bottom: 8px; }
      hr { border: none; border-top: 1px solid #eee; margin: 30px 0; }
      time { color: #666; }
      .back-link { display: inline-block; margin-bottom: 20px; padding: 8px 16px; background: #f1f5f9; border-radius: 6px; }
      footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #eee; color: #666; font-size: 0.9em; }
    </style>
  </head>
  <body>
    <a href={`${siteConfig.url}/`} class="back-link">← 返回首页</a>
    <article>
      <h1>{pageTitle}</h1>
      {post.date && <p>发布于 <time dateTime={post.dateISO}>{post.date}</time></p>}
      <Content />
      <hr />
      <p><a href={canonicalURL}><strong>前往 upxuu.com 阅读完整版本（含交互功能）</strong></a></p>
    </article>
    <footer>
      <p>© {new Date().getFullYear()} <strong>{siteConfig.title}</strong> · <a href={siteConfig.url}>访问站点</a></p>
    </footer>
  </body>
</html>
