---
import { getProcessedPosts } from '../../../utils/postsFetcher';
import { siteConfig, seoConfig, i18nConfig } from '../../../config/site';

const allPosts = await getProcessedPosts();

// Group posts by Year-Month
const archiveMap: Record<string, typeof allPosts> = {};
allPosts.forEach(post => {
  const dateStr = post.date || '';
  const match = dateStr.match(/^(\d{4}-\d{2})/);
  let key = '未知';
  if (match) {
    const [year, month] = match[1].split('-');
    key = `${year}年${month}月`;
  }
  if (!archiveMap[key]) archiveMap[key] = [];
  archiveMap[key].push(post);
});
const archiveKeys = Object.keys(archiveMap).sort((a, b) => b.localeCompare(a));

const pageTitle = `${i18nConfig.archive.title}${seoConfig.titleTemplate}`;
const pageDescription = i18nConfig.archive.description;
const canonicalURL = `${siteConfig.url}/posts/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="zh-CN" />
  </head>
  <body>
    <header>
      <h1>{i18nConfig.archive.title}</h1>
      <p>{pageDescription}</p>
      <p><a href={`${siteConfig.url}/`}>返回首页</a></p>
    </header>

    <main>
      {archiveKeys.map(key => (
        <section>
          <h2>{key}（{archiveMap[key].length} 篇）</h2>
          <ul>
            {archiveMap[key].map(p => (
              <li>
                {p.date && <time>{p.date}</time>} -
                <a href={`${siteConfig.url}/posts/${encodeURIComponent(p.slug)}/`}>{p.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </main>

    <footer>
      <p>© {new Date().getFullYear()} {siteConfig.title}</p>
    </footer>
  </body>
</html>
