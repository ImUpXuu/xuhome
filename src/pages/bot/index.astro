---
import { getProcessedPosts, getProcessedTalks } from '../../utils/postsFetcher';
import { siteConfig, seoConfig } from '../../config/site';

const posts = await getProcessedPosts();
const talks = await getProcessedTalks();

const pageTitle = `${siteConfig.title} - ${siteConfig.subtitle.split(' / ')[0]}`;
const pageDescription = seoConfig.defaultDescription;
const canonicalURL = `${siteConfig.url}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="zh-CN" />
    <meta property="og:image" content={siteConfig.avatar} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={siteConfig.avatar} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": `${siteConfig.url}/#website`,
      "url": siteConfig.url,
      "name": siteConfig.title,
      "description": siteConfig.description,
      "inLanguage": "zh-CN"
    })} />
  </head>
  <body>
    <header>
      <h1>{siteConfig.title} - {siteConfig.subtitle.split(' / ')[0]}</h1>
      <p>{pageDescription}</p>
    </header>

    <nav>
      <h2>导航</h2>
      <ul>
        <li><a href={`${siteConfig.url}/talks`}>说说 / Talks</a></li>
        <li><a href={`${siteConfig.url}/posts`}>归档 / Archive</a></li>
        <li><a href={`${siteConfig.url}/about`}>关于 / About</a></li>
        <li><a href={`${siteConfig.url}/friends`}>友链 / Friends</a></li>
        <li><a href={`${siteConfig.url}/tags`}>标签 / Tags</a></li>
      </ul>
    </nav>

    <section>
      <h2>最新文章（共 {posts.length} 篇）</h2>
      <ul>
        {posts.slice(0, 30).map(p => (
          <li>
            {p.date && <time>{p.date}</time>} -
            <a href={`${siteConfig.url}/posts/${encodeURIComponent(p.slug)}`}>{p.title}</a>
            {p.description && <p>{p.description}</p>}
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>最新说说（共 {talks.length} 条）</h2>
      <ul>
        {talks.slice(0, 20).map(t => (
          <li>
            {t.date && <time>{t.date}</time>} -
            <a href={`${siteConfig.url}/talk/${encodeURIComponent(t.slug)}`}>{t.title || t.date}</a>
          </li>
        ))}
      </ul>
    </section>

    <footer>
      <p>© {new Date().getFullYear()} {siteConfig.title}</p>
    </footer>
  </body>
</html>
