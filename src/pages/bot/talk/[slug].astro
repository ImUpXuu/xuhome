---
import { getProcessedTalks } from '../../utils/postsFetcher';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const talks = await getProcessedTalks();
  return talks.map(talk => ({
    params: { slug: talk.slug },
    props: { talk },
  }));
}

const { talk } = Astro.props;

const canonicalURL = `${siteConfig.url}/talk/${encodeURIComponent(talk.slug)}`;
const pageTitle = talk.title && talk.title !== '日常动态' ? talk.title : (talk.date || '说说');
const pageDescription = (talk.content || '')
  .replace(/!\[.*?\]\(.*?\)/g, '')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[#*`_~>|]/g, '')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 150);

function formatContent(raw: string): string {
  if (!raw) return '';
  let html = raw
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\[([^\]]*)\]\((.*?)\)/g, '<a href="$2">$1</a>');
  return html.split('\n\n').map(p => `<p>${p.replace(/\n/g, '<br/>')}</p>`).join('');
}

function extractImages(raw: string): string[] {
  const regex = /!\[.*?\]\((.*?)\)/g;
  return Array.from(raw.matchAll(regex)).map(m => m[1]);
}

const contentHTML = formatContent((talk.content || '').replace(/!\[.*?\]\(.*?\)/g, ''));
const images = extractImages(talk.content || '');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="zh-CN" />
    {images[0] && <meta property="og:image" content={images[0]} />}
  </head>
  <body>
    <article>
      <h1>{pageTitle}</h1>
      {talk.date && <p>发布于 {talk.date}</p>}
      {contentHTML && <div class="talk-content" set:html={contentHTML} />}
      {images.length > 0 && (
        <div>
          {images.map(src => (
            <p><img src={src} alt="" loading="lazy" /></p>
          ))}
        </div>
      )}
      {(talk.location || talk.weather || talk.device) && (
        <p>
          {[talk.location, talk.weather, talk.device].filter(Boolean).join(' · ')}
        </p>
      )}
      <p><a href={canonicalURL}>前往 upxuu.com 查看完整说说（含交互功能）</a></p>
    </article>
  </body>
</html>
